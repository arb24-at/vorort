---
import { siteConfig } from "../data/site";
import type { Locale } from "../data/services";

type Props = {
  locale?: Locale;
};

const { locale = "de" } = Astro.props;
const copy = locale === "en"
  ? {
      id: "contact",
      eyebrow: "Contact",
      title: "Do you need IT help in Berlin?",
      intro: "Describe the issue briefly. We will clarify the appropriate next step by phone or email.",
      call: "Call now",
      whatsapp: "Write on WhatsApp",
      phone: "Phone",
      email: "Email",
      formTitle: "Prepare an email enquiry",
      formIntro: "Submitting this form opens your email app with the request prepared for you.",
      name: "Name",
      namePlaceholder: "Your name",
      emailLabel: "Email",
      emailPlaceholder: "Your email address",
      request: "Request",
      requestPlaceholder: "Briefly describe the problem or planned work",
      submit: "Prepare email"
    }
  : {
      id: "kontakt",
      eyebrow: "Kontakt",
      title: "Sie benötigen IT-Hilfe in Berlin?",
      intro: "Schildern Sie Ihr Anliegen kurz. Den passenden nächsten Schritt klären wir telefonisch oder per E-Mail.",
      call: "Jetzt anrufen",
      whatsapp: "Über WhatsApp schreiben",
      phone: "Telefon",
      email: "E-Mail",
      formTitle: "E-Mail-Anfrage vorbereiten",
      formIntro: "Beim Absenden öffnet sich Ihr E-Mail-Programm mit der vorbereiteten Anfrage.",
      name: "Name",
      namePlaceholder: "Ihr Name",
      emailLabel: "E-Mail",
      emailPlaceholder: "Ihre E-Mail-Adresse",
      request: "Anliegen",
      requestPlaceholder: "Beschreiben Sie kurz Ihr Problem oder Ihr Vorhaben",
      submit: "E-Mail vorbereiten"
    };
const languageCopy = siteConfig.languageSupport[locale];
---

<section class="section" id={copy.id}>
  <div class="container">
    <div class="contact-slab">
      <section class="contact-intro">
        <span class="eyebrow" style="background: rgba(255,255,255,0.12); color: #e2e8f0;">{copy.eyebrow}</span>
        <h2 class="section-title" style="margin-top: 0.7rem; color: #fff;">
          {copy.title}
        </h2>
        <p>{copy.intro}</p>
        <div class="btn-row" style="margin-top: 1rem;">
          <a class="btn btn-primary" href={siteConfig.contact.phoneHref}>{copy.call}</a>
          <a class="btn btn-secondary" href={siteConfig.contact.whatsappHref}>{copy.whatsapp}</a>
        </div>
        <div class="contact-meta" style="margin-top: 1rem;">
          <article class="card">
            <h3>{copy.phone}</h3>
            <p><a href={siteConfig.contact.phoneHref}>{siteConfig.contact.phoneDisplay}</a></p>
          </article>
          <article class="card">
            <h3>{copy.email}</h3>
            <p><a href={`mailto:${siteConfig.contact.email}`}>{siteConfig.contact.email}</a></p>
          </article>
        </div>
      </section>

      <section class="contact-form-wrap">
        <h3 style="margin-top: 0;">{copy.formTitle}</h3>
        <p style="color: var(--ink-700);">{copy.formIntro}</p>
        {siteConfig.languageSupport.enabled && (
          <p class="operator-language-note"><strong>{languageCopy.title}</strong> {languageCopy.text}</p>
        )}
        <form action={`mailto:${siteConfig.contact.email}`} method="post" enctype="text/plain">
          <div class="form-group">
            <label for={`${copy.id}-name`}>{copy.name}</label>
            <input id={`${copy.id}-name`} type="text" name="name" placeholder={copy.namePlaceholder} required />
          </div>
          <div class="form-group">
            <label for={`${copy.id}-email`}>{copy.emailLabel}</label>
            <input id={`${copy.id}-email`} type="email" name="email" placeholder={copy.emailPlaceholder} required />
          </div>
          <div class="form-group">
            <label for={`${copy.id}-request`}>{copy.request}</label>
            <textarea
              id={`${copy.id}-request`}
              name="request"
              rows="5"
              placeholder={copy.requestPlaceholder}
              required
            ></textarea>
          </div>
          <button class="btn btn-primary" type="submit" style="width: 100%;">{copy.submit}</button>
        </form>
      </section>
    </div>
  </div>
</section>
