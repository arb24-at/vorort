---
import { withBase } from "../utils/withBase";
import type { Locale } from "../data/services";

type Props = {
  locale?: Locale;
};

const { locale = "de" } = Astro.props;
const copy = locale === "en"
  ? {
      label: "Certificates and trust badges",
      microsoftAlt: "Placeholder for Microsoft Certified badge",
      microsoftTodo: "Placeholder until the verified certificate badge is supplied.",
      privacyAlt: "Placeholder for GDPR-conscious processes",
      privacyTodo: "Process badge placeholder; not an independent certification."
    }
  : {
      label: "Zertifikate und Trust-Badges",
      microsoftAlt: "Platzhalter für Microsoft Certified Badge",
      microsoftTodo: "Platzhalter, bis der nachprüfbare Zertifikatsnachweis vorliegt.",
      privacyAlt: "Platzhalter für DSGVO-bewusste Prozesse",
      privacyTodo: "Prozess-Badge als Platzhalter; keine unabhängige Zertifizierung."
    };
---

<section aria-label={copy.label} class="badge-grid">
  <article class="badge-card">
    <img
      src={withBase("assets/badges/microsoft-certified-placeholder.svg")}
      width="360"
      height="120"
      alt={copy.microsoftAlt}
      loading="lazy"
    />
    <p>{copy.microsoftTodo}</p>
  </article>
  <article class="badge-card">
    <img
      src={withBase("assets/badges/dsgvo-compliant-placeholder.svg")}
      width="360"
      height="120"
      alt={copy.privacyAlt}
      loading="lazy"
    />
    <p>{copy.privacyTodo}</p>
  </article>
</section>
