---
import { siteConfig } from "../data/site";
import type { Locale } from "../data/services";

type Props = {
  locale?: Locale;
  context?: "general" | "private" | "business";
};

const { locale = "de", context = "general" } = Astro.props;
const copy = locale === "en"
  ? {
      id: "contact",
      eyebrow: "Your next step",
      title: "Tell us what is not working.",
      intro: "You do not need a technical diagnosis. A short description is enough for an initial review.",
      call: "Call now",
      whatsapp: "Write on WhatsApp",
      phone: "Phone",
      email: "Email",
      formToggle: "Use the enquiry form",
      formTitle: "Prepare an email enquiry",
      formIntro: "For now, the form prepares a structured message in your email app. A direct form endpoint will replace this before production launch.",
      name: "Name",
      namePlaceholder: "Your name",
      contactLabel: "Phone or email",
      contactPlaceholder: "How can we reach you?",
      method: "Preferred contact",
      methods: ["Phone", "WhatsApp", "Email"],
      postcode: "Postcode or district",
      postcodePlaceholder: "For example 10999 or Kreuzberg",
      customerType: "Context",
      customerTypes: ["Private", "Home office / freelance", "Business"],
      company: "Company name (optional)",
      affected: "Affected device or service",
      affectedPlaceholder: "For example Windows laptop, Wi-Fi or Microsoft 365",
      period: "Preferred appointment period (optional)",
      request: "What is happening?",
      requestPlaceholder: "Briefly describe the problem and what you need to be able to do again.",
      consent: "I agree that my details may be used to respond to this enquiry.",
      safety: "Never send passwords, authentication codes, recovery codes or remote-access credentials.",
      submit: "Prepare enquiry email"
    }
  : {
      id: "kontakt",
      eyebrow: "Ihr nächster Schritt",
      title: "Schildern Sie, was nicht funktioniert.",
      intro: "Sie brauchen keine technische Diagnose. Eine kurze Beschreibung reicht für die erste Prüfung.",
      call: "Jetzt anrufen",
      whatsapp: "Über WhatsApp schreiben",
      phone: "Telefon",
      email: "E-Mail",
      formToggle: "Anfrageformular verwenden",
      formTitle: "E-Mail-Anfrage vorbereiten",
      formIntro: "Derzeit bereitet das Formular eine strukturierte Nachricht in Ihrem E-Mail-Programm vor. Vor dem Produktionsstart wird es durch einen direkten Formular-Endpunkt ersetzt.",
      name: "Name",
      namePlaceholder: "Ihr Name",
      contactLabel: "Telefon oder E-Mail",
      contactPlaceholder: "Wie können wir Sie erreichen?",
      method: "Bevorzugter Kontakt",
      methods: ["Telefon", "WhatsApp", "E-Mail"],
      postcode: "Postleitzahl oder Bezirk",
      postcodePlaceholder: "Zum Beispiel 10999 oder Kreuzberg",
      customerType: "Kontext",
      customerTypes: ["Privat", "Homeoffice / selbstständig", "Unternehmen"],
      company: "Unternehmensname (optional)",
      affected: "Betroffenes Gerät oder Dienst",
      affectedPlaceholder: "Zum Beispiel Windows-Laptop, WLAN oder Microsoft 365",
      period: "Bevorzugter Terminzeitraum (optional)",
      request: "Was passiert gerade?",
      requestPlaceholder: "Beschreiben Sie kurz das Problem und was anschließend wieder funktionieren soll.",
      consent: "Ich bin damit einverstanden, dass meine Angaben zur Beantwortung der Anfrage verwendet werden.",
      safety: "Senden Sie niemals Passwörter, Anmelde-, Wiederherstellungs- oder Fernzugangsdaten.",
      submit: "Anfrage-E-Mail vorbereiten"
    };
const languageCopy = siteConfig.languageSupport[locale];
---

<section class="section contact-section" id={copy.id}>
  <div class="container">
    <div class="contact-slab">
      <section class="contact-intro">
        <span class="eyebrow eyebrow--dark">{copy.eyebrow}</span>
        <h2 class="section-title">{copy.title}</h2>
        <p>{copy.intro}</p>
        <div class="contact-channels">
          <a class="contact-channel" href={siteConfig.contact.phoneHref}>
            <span aria-hidden="true">01</span>
            <strong>{copy.call}</strong>
            <small>{siteConfig.contact.phoneDisplay}</small>
          </a>
          <a class="contact-channel" href={siteConfig.contact.whatsappHref}>
            <span aria-hidden="true">02</span>
            <strong>{copy.whatsapp}</strong>
            <small>WhatsApp</small>
          </a>
        </div>
        <p class="contact-language"><strong>{languageCopy.title}</strong> {languageCopy.text}</p>
        <div class="contact-orbit" aria-hidden="true"><i></i><i></i><i></i></div>
      </section>

      <details class="contact-form-disclosure" data-contact-details open>
        <summary>{copy.formToggle}<span aria-hidden="true">＋</span></summary>
        <div class="contact-form-wrap">
          <h3>{copy.formTitle}</h3>
          <p>{copy.formIntro}</p>
          <form class="contact-form" action={`mailto:${siteConfig.contact.email}`} method="post" enctype="text/plain">
            <div class="form-grid">
              <div class="form-group">
                <label for={`${copy.id}-name`}>{copy.name}</label>
                <input id={`${copy.id}-name`} type="text" name="name" placeholder={copy.namePlaceholder} autocomplete="name" required />
              </div>
              <div class="form-group">
                <label for={`${copy.id}-contact`}>{copy.contactLabel}</label>
                <input id={`${copy.id}-contact`} type="text" name="contact" placeholder={copy.contactPlaceholder} required />
              </div>
              <div class="form-group">
                <label for={`${copy.id}-method`}>{copy.method}</label>
                <select id={`${copy.id}-method`} name="preferred-contact">
                  {copy.methods.map((method) => <option>{method}</option>)}
                </select>
              </div>
              <div class="form-group">
                <label for={`${copy.id}-postcode`}>{copy.postcode}</label>
                <input id={`${copy.id}-postcode`} type="text" name="postcode" placeholder={copy.postcodePlaceholder} autocomplete="postal-code" />
              </div>
              <div class="form-group">
                <label for={`${copy.id}-context`}>{copy.customerType}</label>
                <select id={`${copy.id}-context`} name="context">
                  {copy.customerTypes.map((type, index) => <option selected={(context === "private" && index === 0) || (context === "business" && index === 2)}>{type}</option>)}
                </select>
              </div>
              <div class="form-group">
                <label for={`${copy.id}-company`}>{copy.company}</label>
                <input id={`${copy.id}-company`} type="text" name="company" autocomplete="organization" />
              </div>
              <div class="form-group form-group--wide">
                <label for={`${copy.id}-affected`}>{copy.affected}</label>
                <input id={`${copy.id}-affected`} type="text" name="affected" placeholder={copy.affectedPlaceholder} />
              </div>
              <div class="form-group form-group--wide">
                <label for={`${copy.id}-period`}>{copy.period}</label>
                <input id={`${copy.id}-period`} type="text" name="appointment-period" />
              </div>
              <div class="form-group form-group--wide">
                <label for={`${copy.id}-request`}>{copy.request}</label>
                <textarea id={`${copy.id}-request`} name="request" rows="5" placeholder={copy.requestPlaceholder} required></textarea>
              </div>
            </div>
            <p class="form-safety"><span aria-hidden="true">!</span>{copy.safety}</p>
            <label class="form-consent" for={`${copy.id}-consent`}>
              <input id={`${copy.id}-consent`} type="checkbox" name="consent" required />
              <span>{copy.consent}</span>
            </label>
            <button class="btn btn-primary btn-wide" type="submit">{copy.submit}</button>
          </form>
        </div>
      </details>
    </div>
  </div>
</section>

<script>
  const smallScreen = window.matchMedia("(max-width: 739px)");
  document.querySelectorAll<HTMLDetailsElement>("[data-contact-details]").forEach((details) => {
    if (smallScreen.matches) details.removeAttribute("open");
  });
</script>
