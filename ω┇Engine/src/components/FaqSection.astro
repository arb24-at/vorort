---
import type { Locale } from "../data/services";

type Props = {
  locale?: Locale;
};

const { locale = "de" } = Astro.props;
const copy = locale === "en"
  ? {
      eyebrow: "Before you get in touch",
      title: "Questions that are easier to answer upfront.",
      intro: "Short, practical answers without turning the first enquiry into a technical interview.",
      items: [
        { q: "Where in Berlin is on-site support available?", a: "We accept enquiries from every Berlin district. We clarify whether an on-site visit or complementary remote help is appropriate after reviewing the issue." },
        { q: "Can I receive an exact price before the appointment?", a: "When the problem and scope are sufficiently clear, we provide an indication in advance. An unclear cause may require a paid diagnostic visit first." },
        { q: "Do you also support small businesses without internal IT?", a: "Yes. We primarily help small teams, practices, shops, studios and similar workplaces with individual problems, projects and optional recurring support." },
        { q: "Should I send passwords with my enquiry?", a: "No. Never send passwords, authentication codes, recovery codes or remote-access credentials through the form. Necessary access is clarified in the appropriate work context." }
      ]
    }
  : {
      eyebrow: "Vor der Anfrage",
      title: "Fragen, die sich vorher leichter klären lassen.",
      intro: "Kurze, praktische Antworten, ohne aus der ersten Anfrage ein technisches Interview zu machen.",
      items: [
        { q: "Wo in Berlin bieten Sie Vor-Ort-Service an?", a: "Wir nehmen Anfragen aus allen Berliner Bezirken an. Ob ein Vor-Ort-Termin oder ergänzende Remote-Hilfe sinnvoll ist, klären wir anhand Ihres Anliegens." },
        { q: "Kann ich vor dem Termin einen genauen Preis erhalten?", a: "Wenn Problem und Umfang ausreichend klar sind, geben wir vorab eine Einschätzung. Bei unklarer Ursache kann zunächst ein kostenpflichtiger Diagnose-Termin erforderlich sein." },
        { q: "Unterstützen Sie kleine Unternehmen ohne interne IT?", a: "Ja. Wir helfen vor allem kleinen Teams, Praxen, Shops, Studios und ähnlichen Arbeitsplätzen bei einzelnen Problemen, Projekten und bei Bedarf wiederkehrend." },
        { q: "Soll ich Passwörter mit der Anfrage senden?", a: "Nein. Senden Sie niemals Passwörter, Anmelde-, Wiederherstellungs- oder Fernzugangsdaten über das Formular. Erforderliche Zugriffe werden erst im passenden Arbeitskontext geklärt." }
      ]
    };
---

<section class="section faq-section" id="faq">
  <div class="container faq-layout">
    <div class="faq-layout__heading">
      <span class="eyebrow">{copy.eyebrow}</span>
      <h2 class="section-title">{copy.title}</h2>
      <p class="section-lead">{copy.intro}</p>
    </div>
    <div class="faq-list">
      {copy.items.map((item, index) => (
        <details class="faq-item" open={index === 0}>
          <summary><span>0{index + 1}</span>{item.q}<i aria-hidden="true">＋</i></summary>
          <p>{item.a}</p>
        </details>
      ))}
    </div>
  </div>
</section>
