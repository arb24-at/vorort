---
import { legalNavigation, legalNavigationEn, mainNavigation, mainNavigationEn } from "../data/navigation";
import { siteConfig } from "../data/site";
import { withBase } from "../utils/withBase";
import type { Locale } from "../data/services";

type Props = {
  locale?: Locale;
};

const year = new Date().getFullYear();
const toHref = (path: string) => withBase(path);
const { locale = "de" } = Astro.props;
const navigation = locale === "en" ? mainNavigationEn : mainNavigation;
const legal = locale === "en" ? legalNavigationEn : legalNavigation;
const copy = locale === "en"
  ? {
      intro: "Practical IT support for private customers and businesses in Berlin, on site and remote.",
      services: "Services",
      districts: "Service area",
      trust: "Experience & service",
      rights: "All rights reserved."
    }
  : {
      intro: "IT-Service für Privatkunden und Unternehmen in Berlin mit Vor-Ort-Hilfe, klaren Prozessen und Fokus auf Datensicherheit.",
      services: "Leistungen",
      districts: "Servicegebiet",
      trust: "Erfahrung & Service",
      rights: "Alle Rechte vorbehalten."
    };
---

<footer class="site-footer">
  <div class="container">
    <div class="footer-grid">
      <section>
        <h2 class="footer-title">{siteConfig.shortName}</h2>
        <p>
          {copy.intro}
        </p>
        <p>
          Kontakt: <a href={siteConfig.contact.phoneHref}>{siteConfig.contact.phoneDisplay}</a> |
          <a href={`mailto:${siteConfig.contact.email}`}> {siteConfig.contact.email}</a>
        </p>
      </section>

      <section>
        <h2 class="footer-title">{copy.services}</h2>
        <ul class="footer-links">
          {navigation.map((item) => (
            <li><a href={toHref(item.href)}>{item.label}</a></li>
          ))}
        </ul>
      </section>

      <section>
        <h2 class="footer-title">{copy.districts}</h2>
        <ul class="footer-links">
          <li>{locale === "en" ? "All Berlin districts" : "Alle Berliner Bezirke"}</li>
          <li>{locale === "en" ? "On-site as the primary service" : "Vor Ort als Schwerpunkt"}</li>
          <li>{locale === "en" ? "Remote help when appropriate" : "Remote-Hilfe, wenn sinnvoll"}</li>
        </ul>
      </section>

      <section>
        <h2 class="footer-title">{copy.trust}</h2>
        <ul class="footer-links">
          <li>{locale === "en" ? "IT experience since 2008" : "IT-Erfahrung seit 2008"}</li>
          <li>{locale === "en" ? "English-speaking technical service" : "Technischer Service auf Englisch"}</li>
          <li>{locale === "en" ? "Clear scope and next steps" : "Klare Einschätzung und nächste Schritte"}</li>
        </ul>
      </section>
    </div>

    <div class="footer-note">
      <span>© {year} {siteConfig.shortName}. {copy.rights}</span>
      <span>
        {legal.map((item, index) => (
          <>
            <a href={toHref(item.href)}>{item.label}</a>
            {index < legal.length - 1 ? " | " : ""}
          </>
        ))}
      </span>
    </div>
  </div>
</footer>
