---
import { legalNavigation, legalNavigationEn, mainNavigation, mainNavigationEn } from "../data/navigation";
import { siteConfig } from "../data/site";
import { withBase } from "../utils/withBase";
import type { Locale } from "../data/services";

type Props = {
  locale?: Locale;
};

const year = new Date().getFullYear();
const toHref = (path: string) => withBase(path);
const { locale = "de" } = Astro.props;
const navigation = locale === "en" ? mainNavigationEn : mainNavigation;
const legal = locale === "en" ? legalNavigationEn : legalNavigation;
const copy = locale === "en"
  ? {
      intro: "Practical IT support for private customers and businesses in Berlin, on site and remote.",
      services: "Explore",
      contact: "Contact",
      rights: "All rights reserved."
    }
  : {
      intro: "IT-Service für Privatkunden und Unternehmen in Berlin mit Vor-Ort-Hilfe, klaren Prozessen und Fokus auf Datensicherheit.",
      services: "Entdecken",
      contact: "Kontakt",
      rights: "Alle Rechte vorbehalten."
    };
---

<footer class="site-footer">
  <div class="container">
    <div class="footer-grid footer-grid--compact">
      <section class="footer-intro">
        <h2 class="footer-title">{siteConfig.shortName}</h2>
        <p>{copy.intro}</p>
        <div class="footer-signals">
          <span>{locale === "en" ? "On site throughout Berlin" : "Vor Ort in ganz Berlin"}</span>
          <span>{locale === "en" ? "IT experience since 2008" : "IT-Erfahrung seit 2008"}</span>
        </div>
      </section>

      <section>
        <h2 class="footer-title">{copy.services}</h2>
        <ul class="footer-links">
          {navigation.map((item) => (
            <li><a href={toHref(item.href)}>{item.label}</a></li>
          ))}
        </ul>
      </section>

      <section class="footer-contact">
        <h2 class="footer-title">{copy.contact}</h2>
        <ul class="footer-links">
          <li><a href={siteConfig.contact.phoneHref}>{siteConfig.contact.phoneDisplay}</a></li>
          <li><a href={siteConfig.contact.whatsappHref}>WhatsApp</a></li>
          <li><a href={`mailto:${siteConfig.contact.email}`}>{siteConfig.contact.email}</a></li>
        </ul>
      </section>
    </div>

    <div class="footer-note">
      <span>© {year} {siteConfig.shortName}. {copy.rights}</span>
      <span>
        {legal.map((item, index) => (
          <>
            <a href={toHref(item.href)}>{item.label}</a>
            {index < legal.length - 1 ? " | " : ""}
          </>
        ))}
      </span>
    </div>
  </div>
</footer>
