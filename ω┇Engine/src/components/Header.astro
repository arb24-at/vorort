---
import { mainNavigation, mainNavigationEn } from "../data/navigation";
import { siteConfig } from "../data/site";
import { withBase } from "../utils/withBase";
import type { Locale } from "../data/services";

type Props = {
  currentPath?: string;
  locale?: Locale;
  alternatePath?: string;
};

const { currentPath = "/", locale = "de", alternatePath } = Astro.props;
const toHref = (path: string) => withBase(path);
const baseHref = withBase("");
const baseNoTrailingSlash = baseHref.replace(/\/$/, "");

const normalizePath = (path: string) => {
  if (!path) return "";
  const noLeading = path.replace(/^\/+/, "");
  return noLeading.endsWith("/") ? noLeading : `${noLeading}/`;
};

const currentPathWithoutBase = (() => {
  if (currentPath === baseNoTrailingSlash || currentPath === baseHref) return "";
  if (currentPath.startsWith(`${baseNoTrailingSlash}/`)) {
    return currentPath.slice(baseNoTrailingSlash.length + 1);
  }
  return currentPath.replace(/^\/+/, "");
})();

const currentRelativePath = normalizePath(currentPathWithoutBase);
const headerNavigation = (locale === "en" ? mainNavigationEn : mainNavigation).filter(
  (item) => item.href !== "datensicherheit-zertifizierungen/"
);
const labels = locale === "en"
  ? { home: "home page", cta: "Request support", menu: "Open menu", close: "Close menu", language: "DE", nav: "Main navigation", tagline: "On-site IT · Berlin" }
  : { home: "Startseite", cta: "Hilfe anfragen", menu: "Menü öffnen", close: "Menü schließen", language: "EN", nav: "Hauptnavigation", tagline: "IT vor Ort · Berlin" };

const isActive = (href: string) => {
  if (href === "" || href === "en/") return currentRelativePath === normalizePath(href);
  return currentRelativePath.startsWith(normalizePath(href));
};
---

<header class="site-header" id="site-header">
  <div class="mobile-menu-backdrop" id="mobile-menu-backdrop" hidden></div>
  <div class="container">
    <div class="header-shell">
      <a href={locale === "en" ? withBase("en/") : baseHref} class="brand" aria-label={`${siteConfig.name} ${labels.home}`}>
        <span class="brand-mark" aria-hidden="true">
          <svg viewBox="0 0 32 32"><path d="M7 10h8v12H7zM17 6h8v8h-8zM17 16h8v10h-8z"/><path d="M15 11h2M15 21h2M21 14v2"/></svg>
        </span>
        <span>
          <span class="brand-name">{siteConfig.shortName}</span>
          <span class="brand-subline">{labels.tagline}</span>
        </span>
      </a>

      <nav class="nav-desktop" aria-label={labels.nav}>
        {headerNavigation.map((item) => (
          <a class={`nav-link ${isActive(item.href) ? "active" : ""}`} href={toHref(item.href)}>
            {item.label}
          </a>
        ))}
        {alternatePath !== undefined && (
          <a class="nav-link language-switch" href={withBase(alternatePath)} hreflang={locale === "de" ? "en" : "de"}>
            {labels.language}
          </a>
        )}
        <a class="btn btn-primary nav-cta" href={locale === "en" ? "#contact" : "#kontakt"}>{labels.cta}</a>
      </nav>

      <button
        id="mobile-toggle"
        class="mobile-toggle"
        aria-expanded="false"
        aria-controls="mobile-menu"
        aria-label={labels.menu}
        data-open-label={labels.menu}
        data-close-label={labels.close}
      >
      <span></span><span></span><span></span>
      </button>
    </div>

    <nav id="mobile-menu" class="mobile-menu" aria-label={labels.nav} hidden>
      {headerNavigation.map((item) => (
        <a class={`mobile-link ${isActive(item.href) ? "active" : ""}`} href={toHref(item.href)}>
          {item.label}
        </a>
      ))}
      {alternatePath !== undefined && (
        <a class="mobile-link" href={withBase(alternatePath)} hreflang={locale === "de" ? "en" : "de"}>
          {labels.language}
        </a>
      )}
      <a class="btn btn-primary" href={locale === "en" ? "#contact" : "#kontakt"}>{labels.cta}</a>
    </nav>
  </div>
</header>

<script>
  const header = document.getElementById("site-header");
  const toggle = document.getElementById("mobile-toggle");
  const menu = document.getElementById("mobile-menu");
  const backdrop = document.getElementById("mobile-menu-backdrop");
  const openLabel = toggle?.getAttribute("data-open-label") ?? "Open menu";
  const closeLabel = toggle?.getAttribute("data-close-label") ?? "Close menu";

  const handleScroll = () => {
    if (!header) return;
    if (window.scrollY > 8) header.classList.add("is-scrolled");
    else header.classList.remove("is-scrolled");
  };

  handleScroll();
  window.addEventListener("scroll", handleScroll);

  toggle?.addEventListener("click", () => {
    if (!menu) return;
    const isHidden = menu.hasAttribute("hidden");
    if (isHidden) {
      menu.removeAttribute("hidden");
      backdrop?.removeAttribute("hidden");
      document.body.classList.add("menu-is-open");
    } else {
      menu.setAttribute("hidden", "hidden");
      backdrop?.setAttribute("hidden", "hidden");
      document.body.classList.remove("menu-is-open");
    }
    toggle.setAttribute("aria-expanded", isHidden ? "true" : "false");
    toggle.setAttribute("aria-label", isHidden ? closeLabel : openLabel);
  });

  const closeMenu = () => {
    menu?.setAttribute("hidden", "hidden");
    backdrop?.setAttribute("hidden", "hidden");
    document.body.classList.remove("menu-is-open");
    toggle?.setAttribute("aria-expanded", "false");
    toggle?.setAttribute("aria-label", openLabel);
  };

  backdrop?.addEventListener("click", closeMenu);
  document.addEventListener("keydown", (event) => {
    if (event.key === "Escape") closeMenu();
  });

  menu?.querySelectorAll("a").forEach((link) => {
    link.addEventListener("click", () => {
      closeMenu();
    });
  });
</script>
