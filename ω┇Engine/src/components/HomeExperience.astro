---
import ContactSection from "./ContactSection.astro";
import FaqSection from "./FaqSection.astro";
import LanguageSupportBanner from "./LanguageSupportBanner.astro";
import VisualPlaceholder from "./VisualPlaceholder.astro";
import type { Locale } from "../data/services";
import { withBase } from "../utils/withBase";

type Props = {
  locale?: Locale;
};

const { locale = "de" } = Astro.props;
const isEnglish = locale === "en";

const copy = isEnglish
  ? {
      eyebrow: "On-site IT support · Berlin",
      title: "On-site IT help. Clear, personal, professional.",
      intro: "For computers, software, networks and workplaces – personal on-site support for private customers, home offices and small businesses in Berlin.",
      primary: "Request IT support",
      secondary: "See common problems",
      proof: ["On site throughout Berlin", "IT experience since 2008", "English-speaking technician"],
      problemEyebrow: "Start with the problem",
      problemTitle: "What is getting in the way today?",
      problemIntro: "You do not need to know the technical cause. Choose the description that comes closest.",
      problems: [
        { code: "01", title: "Computer or laptop", text: "Slow, unstable, no longer starting or showing unexplained messages.", href: "en/services/private/computer-laptop-help/", tone: "coral" },
        { code: "02", title: "Software or account", text: "Applications, email, sign-in, cloud storage or settings are not working together.", href: "en/services/private/setup-data-transfer/", tone: "sand" },
        { code: "03", title: "Wi-Fi or connected devices", text: "Weak coverage, dropouts, printers or devices repeatedly lose their connection.", href: "en/services/private/wifi-home-network/", tone: "mint" },
        { code: "04", title: "Office network or workplace", text: "Recurring disruption affects devices, users or daily business operations.", href: "en/services/business/network-it-support/", tone: "teal" },
        { code: "05", title: "Microsoft 365 or Google", text: "Users, email, files, permissions or collaboration need attention.", href: "en/services/business/", tone: "blue" }
      ],
      processEyebrow: "On-site by design",
      processTitle: "We look at the problem where the technology is actually used.",
      processText: "A short initial conversation helps us decide whether an on-site visit, remote assistance or a diagnostic appointment is the responsible next step.",
      processNotes: ["Initial conversation is free", "Scope indication where possible", "Further work is agreed before proceeding"],
      audienceEyebrow: "Progressive depth",
      audienceTitle: "One service, three levels of context.",
      audiences: [
        { label: "Home", title: "Private customers", text: "Plain-language help with familiar technology and everyday problems.", href: "en/services/private/" },
        { label: "Hybrid", title: "Home office & freelance", text: "Devices, connectivity, software and accounts that must work together reliably.", href: "en/services/private/" },
        { label: "Work", title: "Small businesses", text: "Deeper support for workplaces, networks, Microsoft 365 and Google Workspace.", href: "en/services/business/" }
      ],
      evidenceEyebrow: "Competence when you need it",
      evidenceTitle: "Approachable at the entrance. Professionally grounded underneath.",
      evidenceText: "The deeper you move into the site, the more detail we provide about systems, working methods and supported technology—without turning the service into an enterprise consultancy.",
      evidence: ["Windows and workplace software", "Microsoft 365 and Google Workspace", "Wi-Fi, routers and local networks", "Backups, cloud storage and account protection"],
      berlinEyebrow: "Service area",
      berlinTitle: "On-site support across all Berlin districts.",
      berlinText: "Tell us your postcode or district when you get in touch. Appointment timing and the most appropriate support route are clarified individually.",
      berlinCta: "Describe your location and issue"
    }
  : {
      eyebrow: "IT-Service vor Ort · Berlin",
      title: "IT-Hilfe vor Ort. Klar, persönlich, professionell.",
      intro: "Für Computer, Software, Netzwerk und Arbeitsplatz – persönlich vor Ort für Privatkunden, Homeoffice und kleine Unternehmen in Berlin.",
      primary: "IT-Hilfe anfragen",
      secondary: "Typische Probleme ansehen",
      proof: ["Vor Ort in ganz Berlin", "IT-Erfahrung seit 2008", "Techniker-Service auf Englisch"],
      problemEyebrow: "Beim Problem beginnen",
      problemTitle: "Was steht Ihnen heute im Weg?",
      problemIntro: "Sie müssen die technische Ursache nicht kennen. Wählen Sie einfach die Beschreibung, die am ehesten passt.",
      problems: [
        { code: "01", title: "Computer oder Laptop", text: "Langsam, instabil, startet nicht mehr oder zeigt unerklärliche Meldungen.", href: "leistungen/privatpersonen/computer-laptop-hilfe/", tone: "coral" },
        { code: "02", title: "Software oder Konto", text: "Programme, E-Mail, Anmeldung, Cloud-Speicher oder Einstellungen greifen nicht sauber ineinander.", href: "leistungen/privatpersonen/einrichtung-datenumzug/", tone: "sand" },
        { code: "03", title: "WLAN oder Geräte", text: "Schwache Abdeckung, Abbrüche, Drucker oder andere Geräte verlieren die Verbindung.", href: "leistungen/privatpersonen/wlan-heimnetz/", tone: "mint" },
        { code: "04", title: "Büro-Netzwerk oder Arbeitsplatz", text: "Wiederkehrende Störungen betreffen Geräte, Nutzer oder den Arbeitsablauf.", href: "leistungen/unternehmen/netzwerk-it-betreuung/", tone: "teal" },
        { code: "05", title: "Microsoft 365 oder Google", text: "Benutzer, E-Mail, Dateien, Rechte oder Zusammenarbeit brauchen Unterstützung.", href: "leistungen/unternehmen/", tone: "blue" }
      ],
      processEyebrow: "Vor Ort aus Überzeugung",
      processTitle: "Wir betrachten das Problem dort, wo die Technik tatsächlich genutzt wird.",
      processText: "Ein kurzes Erstgespräch hilft uns zu entscheiden, ob ein Vor-Ort-Termin, Remote-Hilfe oder ein Diagnose-Termin der verantwortbare nächste Schritt ist.",
      processNotes: ["Kostenloses Erstgespräch", "Umfangseinschätzung, wenn möglich", "Weitere Arbeit erst nach Absprache"],
      audienceEyebrow: "Progressive Tiefe",
      audienceTitle: "Ein Service, drei Ebenen von Kontext.",
      audiences: [
        { label: "Zuhause", title: "Privatpersonen", text: "Verständliche Hilfe bei vertrauter Technik und Problemen im Alltag.", href: "leistungen/privatpersonen/" },
        { label: "Hybrid", title: "Homeoffice & Selbstständige", text: "Geräte, Verbindung, Software und Konten, die zuverlässig zusammenspielen müssen.", href: "leistungen/privatpersonen/" },
        { label: "Arbeit", title: "Kleine Unternehmen", text: "Mehr Tiefe für Arbeitsplätze, Netzwerke, Microsoft 365 und Google Workspace.", href: "leistungen/unternehmen/" }
      ],
      evidenceEyebrow: "Kompetenz, wenn Sie sie brauchen",
      evidenceTitle: "Am Eingang zugänglich. Darunter professionell fundiert.",
      evidenceText: "Je tiefer Sie in die Website einsteigen, desto mehr zeigen wir über Systeme, Arbeitsweise und unterstützte Technik – ohne wie eine Enterprise-Beratung aufzutreten.",
      evidence: ["Windows und Arbeitsplatzsoftware", "Microsoft 365 und Google Workspace", "WLAN, Router und lokale Netzwerke", "Backups, Cloud-Speicher und Kontoschutz"],
      berlinEyebrow: "Servicegebiet",
      berlinTitle: "Vor-Ort-Unterstützung in allen Berliner Bezirken.",
      berlinText: "Nennen Sie bei Ihrer Anfrage einfach Postleitzahl oder Bezirk. Termin und passender Supportweg werden individuell geklärt.",
      berlinCta: "Standort und Anliegen schildern"
    };

const contactAnchor = isEnglish ? "en/#contact" : "#kontakt";
---

<section class="home-hero">
  <div class="container home-hero__grid">
    <div class="home-hero__copy">
      <span class="eyebrow eyebrow--light">{copy.eyebrow}</span>
      <h1>{copy.title}</h1>
      <p class="home-hero__intro">{copy.intro}</p>
      <div class="btn-row">
        <a class="btn btn-primary" href={withBase(contactAnchor)}>{copy.primary}</a>
        <a class="btn btn-ghost" href="#problem-start">{copy.secondary}</a>
      </div>
      <ul class="proof-line" aria-label={isEnglish ? "Service facts" : "Service-Fakten"}>
        {copy.proof.map((item) => <li>{item}</li>)}
      </ul>
    </div>
    <VisualPlaceholder variant="home" locale={locale} />
  </div>
</section>

<LanguageSupportBanner locale={locale} />

<section class="section problem-section" id="problem-start">
  <div class="container">
    <div class="section-heading section-heading--split">
      <div>
        <span class="eyebrow">{copy.problemEyebrow}</span>
        <h2 class="section-title">{copy.problemTitle}</h2>
      </div>
      <p class="section-lead">{copy.problemIntro}</p>
    </div>
    <div class="problem-grid">
      {copy.problems.map((problem) => (
        <a class={`problem-tile problem-tile--${problem.tone}`} href={withBase(problem.href)}>
          <span class="problem-tile__code">{problem.code}</span>
          <div>
            <h3>{problem.title}</h3>
            <p>{problem.text}</p>
          </div>
          <span class="problem-tile__arrow" aria-hidden="true">↗</span>
        </a>
      ))}
    </div>
  </div>
</section>

<section class="section section--ink process-section">
  <div class="container process-layout">
    <div class="process-layout__copy">
      <span class="eyebrow eyebrow--dark">{copy.processEyebrow}</span>
      <h2 class="section-title">{copy.processTitle}</h2>
      <p class="section-lead">{copy.processText}</p>
      <ul class="plain-checks plain-checks--dark">
        {copy.processNotes.map((note) => <li>{note}</li>)}
      </ul>
    </div>
    <VisualPlaceholder variant="journey" locale={locale} compact />
  </div>
</section>

<section class="section audience-section">
  <div class="container">
    <div class="section-heading">
      <span class="eyebrow">{copy.audienceEyebrow}</span>
      <h2 class="section-title">{copy.audienceTitle}</h2>
    </div>
    <div class="audience-grid">
      {copy.audiences.map((audience, index) => (
        <a class={`audience-panel audience-panel--${index + 1}`} href={withBase(audience.href)}>
          <span>{audience.label}</span>
          <h3>{audience.title}</h3>
          <p>{audience.text}</p>
          <b aria-hidden="true">0{index + 1}</b>
        </a>
      ))}
    </div>
  </div>
</section>

<section class="section section--warm evidence-section">
  <div class="container evidence-layout">
    <VisualPlaceholder variant="workspace" locale={locale} compact />
    <div>
      <span class="eyebrow">{copy.evidenceEyebrow}</span>
      <h2 class="section-title">{copy.evidenceTitle}</h2>
      <p class="section-lead">{copy.evidenceText}</p>
      <div class="evidence-list">
        {copy.evidence.map((item, index) => <span><i>0{index + 1}</i>{item}</span>)}
      </div>
    </div>
  </div>
</section>

<section class="section berlin-section">
  <div class="container berlin-layout">
    <div>
      <span class="eyebrow">{copy.berlinEyebrow}</span>
      <h2 class="section-title">{copy.berlinTitle}</h2>
      <p class="section-lead">{copy.berlinText}</p>
      <a class="text-link" href={withBase(contactAnchor)}>{copy.berlinCta}<span aria-hidden="true">→</span></a>
    </div>
    <VisualPlaceholder variant="berlin" locale={locale} compact />
  </div>
</section>

<FaqSection locale={locale} />
<ContactSection locale={locale} context="general" />
