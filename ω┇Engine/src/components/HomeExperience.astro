---
import ContactSection from "./ContactSection.astro";
import ServiceField from "./ServiceField.astro";
import type { Locale } from "../data/services";
import { siteConfig } from "../data/site";
import { withBase } from "../utils/withBase";

type Props = { locale?: Locale };

const { locale = "de" } = Astro.props;
const isEnglish = locale === "en";

const copy = isEnglish
  ? {
      eyebrow: "On-site IT support · Berlin",
      title: "When technology gets in the way, we help you move forward.",
      intro: "Practical help with computers, software, Wi-Fi and workplace IT—at the place where the problem actually happens.",
      primary: "Describe the problem",
      secondary: "Find the right service",
      proof: ["On site throughout Berlin", "IT experience since 2008", "Initial conversation is free"],
      supportLabel: "Technical support in English",
      fieldTitle: "One environment, several connected causes",
      fieldDescription: "A device, its connection and the surrounding workplace are considered together before a change is recommended.",
      problemEyebrow: "Begin with what you notice",
      problemTitle: "What is not working as it should?",
      problemIntro: "You do not need to choose a technical category. Start with the situation that feels closest.",
      problems: [
        { code: "01", title: "The computer is slow, unstable or will not start", text: "For repeated crashes, unusual messages, update trouble or an unreliable Windows computer.", service: "Computer & laptop help", href: "en/services/private/computer-laptop-help/" },
        { code: "02", title: "A program, update or sign-in no longer works", text: "For installation, software conflicts, account issues and a computer that has become cluttered over time.", service: "Software installation & optimisation", href: "en/services/private/software-installation-optimisation/" },
        { code: "03", title: "Wi-Fi drops out or devices lose their connection", text: "For weak coverage, unreliable rooms, router or mesh questions, printers and connected devices.", service: "Wi-Fi & home network", href: "en/services/private/wifi-home-network/" },
        { code: "04", title: "A new computer needs setting up without losing the useful parts", text: "For files, accounts, applications, email, printers and a considered move from the old device.", service: "PC setup & data transfer", href: "en/services/private/setup-data-transfer/" },
        { code: "05", title: "Recurring IT trouble is interrupting the workplace", text: "For office networks, shared devices, Microsoft 365, Google Workspace and problems affecting daily operations.", service: "IT for workplaces and small teams", href: "en/services/business/" }
      ],
      approachId: "approach",
      approachEyebrow: "A responsible next step",
      approachTitle: "Follow the problem from the device to the wider system.",
      approachText: "A short conversation helps us understand the visible problem. On site, we can then inspect the device, connection, account or workplace relationship that is relevant—without turning the first enquiry into a technical interview.",
      steps: [
        { title: "Describe", text: "Tell us what you see and what you need to do again." },
        { title: "Assess", text: "We suggest an on-site visit, remote help or a diagnostic appointment." },
        { title: "Agree", text: "Further work and likely scope are discussed before proceeding." }
      ],
      capabilityTitle: "From a familiar symptom to a clear working state",
      capabilityDescription: "The technical layer becomes more detailed only when it helps explain the cause, scope or handover.",
      capabilityCallouts: ["Device", "Network", "Account", "Workflow"],
      evidence: ["Windows and workplace software", "Wi-Fi, routers and local networks", "Microsoft 365 and Google Workspace", "Backups and account protection"]
    }
  : {
      eyebrow: "IT-Service vor Ort · Berlin",
      title: "Wenn Technik im Weg steht, helfen wir weiter.",
      intro: "Praktische Hilfe bei Computer, Software, WLAN und Arbeitsplatz-IT – dort, wo das Problem tatsächlich auftritt.",
      primary: "Problem schildern",
      secondary: "Passende Hilfe finden",
      proof: ["Vor Ort in ganz Berlin", "IT-Erfahrung seit 2008", "Kostenloses Erstgespräch"],
      supportLabel: "Techniker-Service auf Englisch",
      fieldTitle: "Eine Umgebung, mehrere mögliche Zusammenhänge",
      fieldDescription: "Gerät, Verbindung und Arbeitsplatz werden gemeinsam betrachtet, bevor wir eine Änderung empfehlen.",
      problemEyebrow: "Bei der Situation beginnen",
      problemTitle: "Was funktioniert gerade nicht so, wie es soll?",
      problemIntro: "Sie müssen keine technische Kategorie auswählen. Beginnen Sie einfach mit der Situation, die Ihrem Anliegen am nächsten kommt.",
      problems: [
        { code: "01", title: "Der Computer ist langsam, instabil oder startet nicht", text: "Bei Abstürzen, ungewöhnlichen Meldungen, Update-Problemen oder einem unzuverlässigen Windows-PC.", service: "Computer- & Laptop-Hilfe", href: "leistungen/privatpersonen/computer-laptop-hilfe/" },
        { code: "02", title: "Ein Programm, Update oder Konto funktioniert nicht mehr", text: "Bei Installation, Softwarekonflikten, Anmeldeproblemen oder einem über Jahre unübersichtlich gewordenen System.", service: "Software-Installation & Optimierung", href: "leistungen/privatpersonen/software-installation-optimierung/" },
        { code: "03", title: "Das WLAN bricht ab oder Geräte verlieren die Verbindung", text: "Bei schwacher Abdeckung, problematischen Räumen, Router- oder Mesh-Fragen, Druckern und vernetzten Geräten.", service: "WLAN & Heimnetz", href: "leistungen/privatpersonen/wlan-heimnetz/" },
        { code: "04", title: "Ein neuer Computer soll ohne unnötigen Ballast eingerichtet werden", text: "Für Dateien, Konten, Programme, E-Mail, Drucker und den überlegten Wechsel vom alten Gerät.", service: "PC-Einrichtung & Datenumzug", href: "leistungen/privatpersonen/einrichtung-datenumzug/" },
        { code: "05", title: "Wiederkehrende IT-Störungen bremsen den Arbeitsplatz", text: "Für Büro-Netzwerke, gemeinsame Geräte, Microsoft 365, Google Workspace und Probleme im täglichen Ablauf.", service: "IT für Arbeitsplätze und kleine Teams", href: "leistungen/unternehmen/" }
      ],
      approachId: "arbeitsweise",
      approachEyebrow: "Ein verantwortbarer nächster Schritt",
      approachTitle: "Dem Problem vom Gerät bis zum System folgen.",
      approachText: "Im kurzen Erstgespräch genügt das sichtbare Problem. Vor Ort können wir anschließend genau die Beziehung zwischen Gerät, Verbindung, Konto oder Arbeitsplatz prüfen, die für Ihr Anliegen relevant ist.",
      steps: [
        { title: "Schildern", text: "Sagen Sie uns, was Sie sehen und was wieder möglich sein soll." },
        { title: "Einordnen", text: "Wir empfehlen Vor-Ort-Termin, Remote-Hilfe oder Diagnose." },
        { title: "Absprechen", text: "Weitere Arbeit und möglicher Umfang werden vorab geklärt." }
      ],
      capabilityTitle: "Vom vertrauten Symptom zu einem klaren Arbeitszustand",
      capabilityDescription: "Die technische Ebene wird erst dann tiefer, wenn sie Ursache, Umfang oder Übergabe verständlicher macht.",
      capabilityCallouts: ["Gerät", "Netzwerk", "Konto", "Ablauf"],
      evidence: ["Windows und Arbeitsplatzsoftware", "WLAN, Router und lokale Netzwerke", "Microsoft 365 und Google Workspace", "Backups und Kontoschutz"]
    };

const contactAnchor = isEnglish ? "en/#contact" : "#kontakt";
const languageSupport = siteConfig.languageSupport[locale];
---

<section class="home-hero home-hero--field">
  <div class="container home-hero__field-layout">
    <div class="home-hero__copy">
      <span class="eyebrow eyebrow--light">{copy.eyebrow}</span>
      <h1>{copy.title}</h1>
      <p class="home-hero__intro">{copy.intro}</p>
      <div class="btn-row">
        <a class="btn btn-primary" href={withBase(contactAnchor)}>{copy.primary}</a>
        <a class="btn btn-ghost" href="#problem-start">{copy.secondary}</a>
      </div>
      <ul class="proof-line" aria-label={isEnglish ? "Service facts" : "Service-Fakten"}>
        {copy.proof.map((item) => <li>{item}</li>)}
      </ul>
    </div>
    <ServiceField variant="home" state="place" locale={locale} title={copy.fieldTitle} description={copy.fieldDescription} />
    {siteConfig.languageSupport.enabled && (
      <p class="inline-language-note"><strong>{copy.supportLabel}</strong><span>{languageSupport.text}</span></p>
    )}
  </div>
</section>

<section class="section situation-section" id="problem-start">
  <div class="container">
    <div class="section-heading section-heading--split situation-heading">
      <div>
        <span class="eyebrow">{copy.problemEyebrow}</span>
        <h2 class="section-title">{copy.problemTitle}</h2>
      </div>
      <p class="section-lead">{copy.problemIntro}</p>
    </div>
    <div class="situation-routes">
      {copy.problems.map((problem) => (
        <a class="situation-route" href={withBase(problem.href)}>
          <span class="situation-route__code">{problem.code}</span>
          <div><h3>{problem.title}</h3><p>{problem.text}</p></div>
          <strong>{problem.service}<i aria-hidden="true">→</i></strong>
        </a>
      ))}
    </div>
  </div>
</section>

<section class="section section--ink capability-section" id={copy.approachId}>
  <div class="container capability-layout">
    <div class="capability-copy">
      <span class="eyebrow eyebrow--dark">{copy.approachEyebrow}</span>
      <h2 class="section-title">{copy.approachTitle}</h2>
      <p class="section-lead">{copy.approachText}</p>
      <ol class="approach-rail">
        {copy.steps.map((step, index) => (
          <li><span>0{index + 1}</span><div><strong>{step.title}</strong><p>{step.text}</p></div></li>
        ))}
      </ol>
    </div>
    <ServiceField variant="capability" state="connected" locale={locale} title={copy.capabilityTitle} description={copy.capabilityDescription} callouts={copy.capabilityCallouts} compact />
    <ul class="capability-evidence" aria-label={isEnglish ? "Supported areas" : "Unterstützte Bereiche"}>
      {copy.evidence.map((item) => <li>{item}</li>)}
    </ul>
  </div>
</section>

<ContactSection locale={locale} context="general" compact />
