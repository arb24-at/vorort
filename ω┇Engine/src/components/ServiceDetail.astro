---
import ContactSection from "./ContactSection.astro";
import LanguageSupportBanner from "./LanguageSupportBanner.astro";
import VisualPlaceholder from "./VisualPlaceholder.astro";
import MainLayout from "../layouts/MainLayout.astro";
import { siteConfig } from "../data/site";
import {
  getAlternateServicePath,
  getRelatedServices,
  getServicePath,
  type LocalizedService
} from "../data/services";
import { withBase } from "../utils/withBase";

type Props = {
  service: LocalizedService;
};

const { service } = Astro.props;
const isEnglish = service.locale === "en";
const isPrivatePrototype = service.page.template === "private-prototype";
const isBusinessPrototype = service.page.template === "business-prototype";
const isExpanded = service.page.template === "guided-private" && service.expanded;
const pageKind = isPrivatePrototype || isExpanded ? "private" : isBusinessPrototype ? "business" : "standard";
const visualVariant = service.page.theme.variant;
const relatedServices = isExpanded ? await getRelatedServices(service) : [];
const contactId = isEnglish ? "contact" : "kontakt";
const audienceLandingPath = isEnglish
  ? `en/services/${service.audience}/`
  : `leistungen/${service.audience === "private" ? "privatpersonen" : "unternehmen"}/`;

const copy = isEnglish
  ? {
      request: "Request support",
      whatsapp: "WhatsApp",
      recognitionEyebrow: "Recognise the situation",
      recognitionTitle: "You do not need to diagnose the computer yourself.",
      recognitionIntro: "These symptoms are useful starting points. We narrow down the cause before recommending further work.",
      diagnosticEyebrow: "Understandable diagnosis",
      diagnosticTitle: "From a visible symptom to a responsible next step.",
      diagnosticIntro: "The aim is not to perform as many technical actions as possible. It is to determine what is wrong, what can reasonably be changed and what outcome is worth pursuing.",
      diagnosticSteps: ["Clarify the symptom and recent changes", "Check the system, software and connected devices", "Explain the cause and available options", "Complete agreed work and test the result"],
      boundaryEyebrow: "Clear boundaries",
      boundaryTitle: "Professional troubleshooting—not component-level electronics repair.",
      boundaries: ["No guaranteed recovery from damaged storage", "No passwords or authentication codes through the form", "Replacement or specialist repair is discussed when more economical"],
      outcomeEyebrow: "A useful outcome",
      impactEyebrow: "Operational impact",
      impactTitle: "Start with what the disruption is doing to the workplace.",
      impactIntro: "A network problem matters because meetings fail, devices disappear or work stops. We connect the technical diagnosis to the affected workflow.",
      systemEyebrow: "System layer",
      systemTitle: "See the relationships—not just the failed device.",
      systemIntro: "Small offices combine users, workplaces, Wi-Fi, printers, accounts and shared services. Recurring problems often sit between those parts.",
      technicalEyebrow: "Deeper capability",
      technicalTitle: "Technical detail appears where it helps the decision.",
      technologies: ["Wi-Fi and local networks", "Windows workplaces", "Printers and shared devices", "Accounts and permissions", "Microsoft 365 and Google Workspace", "NAS or small-server requests assessed individually"],
      engagementEyebrow: "Ways to work together",
      oneOffTitle: "One issue or project",
      oneOffText: "A specific disruption, setup, change or improvement can be handled without a long-term agreement.",
      recurringTitle: "Optional recurring support",
      recurringText: "Where a small business has an ongoing need, a repeatable support arrangement can be discussed separately.",
      commonEyebrow: "Service scope",
      commonTitle: "Start with the closest description.",
      commonIntro: "The exact cause and responsible scope are clarified after you get in touch.",
      approachEyebrow: "Approach",
      contactHint: "On-site support is the focus. Remote assistance is used where it genuinely fits the request.",
      backToAudience: "All private services",
      faqEyebrow: "Questions before you contact us",
      faqTitle: "Useful answers about software support",
      relatedEyebrow: "Related situations",
      relatedTitle: "Continue with the service that best matches the task",
      relatedLink: "View service"
    }
  : {
      request: "IT-Hilfe anfragen",
      whatsapp: "WhatsApp",
      recognitionEyebrow: "Situation wiedererkennen",
      recognitionTitle: "Sie müssen den Computer nicht selbst diagnostizieren.",
      recognitionIntro: "Diese Symptome sind sinnvolle Ausgangspunkte. Wir grenzen die Ursache ein, bevor weitere Arbeit empfohlen wird.",
      diagnosticEyebrow: "Verständliche Diagnose",
      diagnosticTitle: "Vom sichtbaren Symptom zum verantwortbaren nächsten Schritt.",
      diagnosticIntro: "Das Ziel ist nicht, möglichst viele technische Handgriffe auszuführen. Wir klären, was nicht stimmt, was sinnvoll geändert werden kann und welches Ergebnis den Aufwand rechtfertigt.",
      diagnosticSteps: ["Symptom und letzte Änderungen klären", "System, Software und verbundene Geräte prüfen", "Ursache und mögliche Wege erklären", "Vereinbarte Arbeit umsetzen und Ergebnis testen"],
      boundaryEyebrow: "Klare Grenzen",
      boundaryTitle: "Professionelle Fehleranalyse – keine Reparatur auf Bauteilebene.",
      boundaries: ["Keine garantierte Rettung beschädigter Datenträger", "Keine Passwörter oder Anmeldecodes über das Formular", "Austausch oder Spezialreparatur werden empfohlen, wenn wirtschaftlicher"],
      outcomeEyebrow: "Ein brauchbares Ergebnis",
      impactEyebrow: "Auswirkung auf den Betrieb",
      impactTitle: "Beginnen wir damit, was die Störung am Arbeitsplatz verursacht.",
      impactIntro: "Ein Netzwerkproblem ist relevant, weil Meetings scheitern, Geräte verschwinden oder Arbeit liegen bleibt. Wir verbinden die technische Diagnose mit dem betroffenen Ablauf.",
      systemEyebrow: "Systemebene",
      systemTitle: "Beziehungen betrachten – nicht nur das ausgefallene Gerät.",
      systemIntro: "Kleine Büros verbinden Nutzer, Arbeitsplätze, WLAN, Drucker, Konten und gemeinsame Dienste. Wiederkehrende Probleme liegen oft zwischen diesen Teilen.",
      technicalEyebrow: "Mehr technische Tiefe",
      technicalTitle: "Technische Details erscheinen dort, wo sie die Entscheidung verbessern.",
      technologies: ["WLAN und lokale Netzwerke", "Windows-Arbeitsplätze", "Drucker und gemeinsam genutzte Geräte", "Konten und Berechtigungen", "Microsoft 365 und Google Workspace", "NAS- oder kleine Server-Anfragen nach Einzelfallprüfung"],
      engagementEyebrow: "Formen der Zusammenarbeit",
      oneOffTitle: "Ein Problem oder Projekt",
      oneOffText: "Eine konkrete Störung, Einrichtung, Änderung oder Verbesserung kann ohne langfristigen Vertrag bearbeitet werden.",
      recurringTitle: "Optionale wiederkehrende Unterstützung",
      recurringText: "Wenn ein kleiner Betrieb regelmäßig Hilfe benötigt, kann eine passende Betreuung separat besprochen werden.",
      commonEyebrow: "Leistungsumfang",
      commonTitle: "Beginnen Sie mit der passendsten Beschreibung.",
      commonIntro: "Die genaue Ursache und der verantwortbare Umfang werden nach Ihrer Kontaktaufnahme geklärt.",
      approachEyebrow: "Arbeitsweise",
      contactHint: "Vor-Ort-Unterstützung ist der Schwerpunkt. Remote-Hilfe nutzen wir, wenn sie wirklich zum Anliegen passt.",
      backToAudience: "Alle Leistungen für Privatkunden",
      faqEyebrow: "Fragen vor der Kontaktaufnahme",
      faqTitle: "Wichtige Antworten zur Software-Unterstützung",
      relatedEyebrow: "Verwandte Situationen",
      relatedTitle: "Zum passenden nächsten Leistungsbereich weitergehen",
      relatedLink: "Leistung ansehen"
    };
---

<MainLayout
  title={`${service.seo.title} | ${siteConfig.defaultTitleSuffix}`}
  description={service.seo.description}
  canonicalPath={getServicePath(service)}
  lang={service.locale}
  alternatePath={getAlternateServicePath(service)}
>
  <section class={`service-hero service-hero--${pageKind} service-hero--theme-${visualVariant}`}>
    <div class="container service-hero__grid">
      <div class="service-hero__copy">
        <a class="service-back-link" href={withBase(audienceLandingPath)}>← {copy.backToAudience}</a>
        <span class="eyebrow eyebrow--light">{service.hero.eyebrow}</span>
        <h1>{service.hero.title}</h1>
        <p>{service.hero.intro}</p>
        <div class="btn-row">
          <a class="btn btn-primary" href={`#${contactId}`}>{copy.request}</a>
          <a class="btn btn-ghost" href={siteConfig.contact.whatsappHref}>{copy.whatsapp}</a>
        </div>
      </div>
      <VisualPlaceholder
        variant={visualVariant}
        locale={service.locale}
        title={service.page.theme.title}
        description={service.page.theme.description}
      />
    </div>
  </section>

  <LanguageSupportBanner locale={service.locale} />

  {isExpanded && (
    <>
      <section class="section software-symptoms-section">
        <div class="container">
          <div class="section-heading section-heading--split">
            <div>
              <span class="eyebrow">{service.problems.eyebrow}</span>
              <h2 class="section-title">{service.problems.title}</h2>
            </div>
            <p class="section-lead">{service.problems.intro}</p>
          </div>
          <div class="software-symptom-grid">
            {service.problems.items.map((problem, index) => (
              <article>
                <span>0{index + 1}</span>
                <p>{problem}</p>
                <i aria-hidden="true"></i>
              </article>
            ))}
          </div>
        </div>
      </section>

      <section class="section section--warm software-situations-section">
        <div class="container">
          <div class="section-heading">
            <span class="eyebrow">{service.expanded.situations.eyebrow}</span>
            <h2 class="section-title">{service.expanded.situations.title}</h2>
            <p class="section-lead">{service.expanded.situations.intro}</p>
          </div>
          <div class="software-situation-grid">
            {service.expanded.situations.items.map((item, index) => (
              <article>
                <span>0{index + 1}</span>
                <h3>{item.title}</h3>
                <p>{item.text}</p>
              </article>
            ))}
          </div>
        </div>
      </section>

      <section class="section section--ink software-process-section">
        <div class="container software-process-layout">
          <div>
            <span class="eyebrow eyebrow--dark">{service.expanded.process.eyebrow}</span>
            <h2 class="section-title">{service.expanded.process.title}</h2>
            <p class="section-lead">{service.expanded.process.intro}</p>
            <ol class="software-process-steps">
              {service.expanded.process.steps.map((step, index) => (
                <li>
                  <span>0{index + 1}</span>
                  <div><h3>{step.title}</h3><p>{step.text}</p></div>
                </li>
              ))}
            </ol>
          </div>
          <VisualPlaceholder
            variant="software"
            locale={service.locale}
            title={service.page.theme.title}
            description={service.page.theme.state}
            compact
          />
        </div>
      </section>

      <section class="section software-scope-section">
        <div class="container scope-layout">
          <div>
            <span class="eyebrow">{service.included.eyebrow}</span>
            <h2 class="section-title">{service.included.title}</h2>
            <p class="section-lead">{service.included.intro}</p>
          </div>
          <ul class="scope-list scope-list--software">
            {service.included.items.map((item, index) => (
              <li><span>0{index + 1}</span>{item}</li>
            ))}
          </ul>
        </div>
      </section>

      <section class="section section--warm software-proof-section">
        <div class="container software-proof-layout">
          <div>
            <span class="eyebrow">{service.expanded.proof.eyebrow}</span>
            <h2 class="section-title">{service.expanded.proof.title}</h2>
            <p class="section-lead">{service.expanded.proof.text}</p>
          </div>
          <div class="software-proof-grid">
            {service.expanded.proof.items.map((item, index) => (
              <span><i>0{index + 1}</i>{item}</span>
            ))}
          </div>
        </div>
      </section>

      <section class="boundary-band boundary-band--software">
        <div class="container boundary-layout">
          <div>
            <span class="eyebrow">{service.expanded.boundaries.eyebrow}</span>
            <h2>{service.expanded.boundaries.title}</h2>
          </div>
          <ul>{service.expanded.boundaries.items.map((item) => <li>{item}</li>)}</ul>
        </div>
      </section>

      <section class="section software-outcome-section">
        <div class="container outcome-layout">
          <div>
            <span class="eyebrow">{service.outcome.eyebrow}</span>
            <h2 class="section-title">{service.outcome.title}</h2>
            <p class="section-lead">{service.outcome.text}</p>
          </div>
          <aside>
            <h3>{service.cta.title}</h3>
            <p>{service.cta.text}</p>
            <p>{service.cta.prompt}</p>
            <a class="text-link" href={`#${contactId}`}>{copy.request}<span aria-hidden="true">→</span></a>
          </aside>
        </div>
      </section>

      <section class="section section--warm service-faq-section">
        <div class="container faq-layout">
          <div class="faq-layout__heading">
            <span class="eyebrow">{copy.faqEyebrow}</span>
            <h2 class="section-title">{copy.faqTitle}</h2>
          </div>
          <div class="faq-list">
            {service.expanded.faqs.map((faq, index) => (
              <details class="faq-item">
                <summary><span>0{index + 1}</span>{faq.question}<i aria-hidden="true">+</i></summary>
                <p>{faq.answer}</p>
              </details>
            ))}
          </div>
        </div>
      </section>

      <section class="section related-services-section">
        <div class="container">
          <div class="section-heading">
            <span class="eyebrow">{copy.relatedEyebrow}</span>
            <h2 class="section-title">{copy.relatedTitle}</h2>
          </div>
          <div class="related-service-grid">
            {relatedServices.map((related, index) => (
              <a href={withBase(getServicePath(related))}>
                <span>0{index + 1}</span>
                <h3>{related.hero.title}</h3>
                <p>{related.seo.description}</p>
                <b>{copy.relatedLink} →</b>
              </a>
            ))}
          </div>
        </div>
      </section>
    </>
  )}

  {isPrivatePrototype && (
    <>
      <section class="section recognition-section">
        <div class="container">
          <div class="section-heading section-heading--split">
            <div>
              <span class="eyebrow">{copy.recognitionEyebrow}</span>
              <h2 class="section-title">{copy.recognitionTitle}</h2>
            </div>
            <p class="section-lead">{copy.recognitionIntro}</p>
          </div>
          <div class="symptom-grid">
            {service.problems.items.map((problem, index) => (
              <article class="symptom-item">
                <span>0{index + 1}</span>
                <p>{problem}</p>
              </article>
            ))}
          </div>
        </div>
      </section>

      <section class="section section--ink diagnostic-section">
        <div class="container diagnostic-layout">
          <VisualPlaceholder variant="computer" locale={service.locale} compact />
          <div>
            <span class="eyebrow eyebrow--dark">{copy.diagnosticEyebrow}</span>
            <h2 class="section-title">{copy.diagnosticTitle}</h2>
            <p class="section-lead">{copy.diagnosticIntro}</p>
            <ol class="diagnostic-steps">
              {copy.diagnosticSteps.map((step, index) => <li><span>0{index + 1}</span>{step}</li>)}
            </ol>
          </div>
        </div>
      </section>

      <section class="section scope-section">
        <div class="container scope-layout">
          <div>
            <span class="eyebrow">{service.included.eyebrow}</span>
            <h2 class="section-title">{service.outcome.title}</h2>
            <p class="section-lead">{service.outcome.text}</p>
          </div>
          <ul class="scope-list">
            {service.included.items.map((item, index) => <li><span>0{index + 1}</span>{item}</li>)}
          </ul>
        </div>
      </section>

      <section class="boundary-band">
        <div class="container boundary-layout">
          <div>
            <span class="eyebrow">{copy.boundaryEyebrow}</span>
            <h2>{copy.boundaryTitle}</h2>
          </div>
          <ul>{copy.boundaries.map((item) => <li>{item}</li>)}</ul>
        </div>
      </section>
    </>
  )}

  {isBusinessPrototype && (
    <>
      <section class="section impact-section">
        <div class="container impact-layout">
          <div>
            <span class="eyebrow">{copy.impactEyebrow}</span>
            <h2 class="section-title">{copy.impactTitle}</h2>
            <p class="section-lead">{copy.impactIntro}</p>
          </div>
          <div class="impact-list">
            {service.problems.items.map((problem, index) => (
              <article><span>0{index + 1}</span><p>{problem}</p></article>
            ))}
          </div>
        </div>
      </section>

      <section class="section section--ink system-section">
        <div class="container system-layout">
          <div>
            <span class="eyebrow eyebrow--dark">{copy.systemEyebrow}</span>
            <h2 class="section-title">{copy.systemTitle}</h2>
            <p class="section-lead">{copy.systemIntro}</p>
            <ul class="plain-checks plain-checks--dark">
              {service.included.items.map((item) => <li>{item}</li>)}
            </ul>
          </div>
          <VisualPlaceholder variant="network" locale={service.locale} compact />
        </div>
      </section>

      <section class="section technical-section">
        <div class="container technical-layout">
          <div>
            <span class="eyebrow">{copy.technicalEyebrow}</span>
            <h2 class="section-title">{copy.technicalTitle}</h2>
          </div>
          <div class="technical-tags">
            {copy.technologies.map((technology, index) => <span><i>0{index + 1}</i>{technology}</span>)}
          </div>
        </div>
      </section>

      <section class="section section--warm engagement-section">
        <div class="container">
          <div class="section-heading">
            <span class="eyebrow">{copy.engagementEyebrow}</span>
            <h2 class="section-title">{service.outcome.title}</h2>
            <p class="section-lead">{service.outcome.text}</p>
          </div>
          <div class="engagement-grid">
            <article><span>01</span><h3>{copy.oneOffTitle}</h3><p>{copy.oneOffText}</p></article>
            <article><span>02</span><h3>{copy.recurringTitle}</h3><p>{copy.recurringText}</p></article>
          </div>
        </div>
      </section>
    </>
  )}

  {!isPrivatePrototype && !isBusinessPrototype && !isExpanded && (
    <>
      <section class="section common-service-section">
        <div class="container">
          <div class="section-heading section-heading--split">
            <div>
              <span class="eyebrow">{copy.commonEyebrow}</span>
              <h2 class="section-title">{copy.commonTitle}</h2>
            </div>
            <p class="section-lead">{copy.commonIntro}</p>
          </div>
          <div class="common-service-grid">
            <article class="service-list-panel">
              <span>01</span><h3>{service.problems.title}</h3>
              <ul>{service.problems.items.map((problem) => <li>{problem}</li>)}</ul>
            </article>
            <VisualPlaceholder variant={visualVariant} locale={service.locale} compact />
            <article class="service-list-panel service-list-panel--accent">
              <span>02</span><h3>{service.included.title}</h3>
              <ul>{service.included.items.map((item) => <li>{item}</li>)}</ul>
            </article>
          </div>
        </div>
      </section>

      <section class="section section--warm common-outcome-section">
        <div class="container outcome-layout">
          <div>
            <span class="eyebrow">{copy.approachEyebrow}</span>
            <h2 class="section-title">{service.outcome.title}</h2>
            <p class="section-lead">{service.outcome.text}</p>
          </div>
          <aside>
            <h3>{service.cta.title}</h3>
            <p>{service.cta.text}</p>
            <p>{copy.contactHint}</p>
          </aside>
        </div>
      </section>
    </>
  )}

  <ContactSection locale={service.locale} context={service.audience} />
</MainLayout>
