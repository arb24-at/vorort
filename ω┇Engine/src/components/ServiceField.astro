---
import type { Locale } from "../data/services";
import { withBase } from "../utils/withBase";

type Variant = "home" | "capability" | "software";
type State = "place" | "connected" | "conflict" | "dependencies" | "controlled-change" | "verified";

type Props = {
  variant: Variant;
  state: State;
  locale?: Locale;
  title: string;
  description: string;
  callouts?: string[];
  compact?: boolean;
  showCaption?: boolean;
};

const {
  variant,
  state,
  locale = "de",
  title,
  description,
  callouts = [],
  compact = false,
  showCaption = true
} = Astro.props;

const stateLabel = locale === "en"
  ? {
      place: "Where the technology is used",
      connected: "Device, connection and workplace",
      conflict: "Visible problem",
      dependencies: "Connected causes",
      "controlled-change": "Agreed change",
      verified: "Checked working state"
    }[state]
  : {
      place: "Wo die Technik genutzt wird",
      connected: "Gerät, Verbindung und Arbeitsplatz",
      conflict: "Sichtbare Störung",
      dependencies: "Verbundene Ursachen",
      "controlled-change": "Vereinbarte Änderung",
      verified: "Geprüfter Arbeitszustand"
    }[state];

const defaultCallouts = locale === "en"
  ? ["Problem described", "Connection checked", "Access confirmed"]
  : ["Problem geschildert", "Verbindung geprüft", "Zugang bestätigt"];

const visibleCallouts = callouts.length > 0 ? callouts : defaultCallouts;
const isEnvironment = variant === "home" && state === "place";
const visualHeading = locale === "en"
  ? {
      connected: "Following the affected path",
      conflict: "What is visibly going wrong",
      dependencies: "What may be connected beneath it",
      "controlled-change": "Changing only what was agreed",
      verified: "The working state is checked together",
      place: "On-site support where technology is used"
    }[state]
  : {
      connected: "Den betroffenen Weg nachvollziehen",
      conflict: "Was sichtbar nicht funktioniert",
      dependencies: "Was darunter zusammenhängen kann",
      "controlled-change": "Nur das Vereinbarte verändern",
      verified: "Den Arbeitszustand gemeinsam prüfen",
      place: "Vor-Ort-Hilfe dort, wo Technik genutzt wird"
    }[state];
const checkpointLabel = locale === "en" ? "Checkpoint" : "Kontrollpunkt";
const titleId = `field-${variant}-${state}-${title.toLowerCase().replace(/[^a-z0-9]+/g, "-").slice(0, 24)}`;
---

<figure
  class:list={["service-field", `service-field--${variant}`, `service-field--${state}`, { "service-field--compact": compact }]}
  aria-labelledby={titleId}
>
  <div class="service-field__scene">
    {isEnvironment ? (
      <>
        <img
          src={withBase("images/technical-field-berlin.jpg")}
          alt=""
          width="1706"
          height="922"
          loading="eager"
          decoding="async"
        />
        <div class="service-field__shade" aria-hidden="true"></div>
        <span class="service-field__environment-note"><i aria-hidden="true"></i>{visualHeading}</span>
      </>
    ) : (
      <div class:list={["service-field__graphic", `service-field__graphic--${state}`]}>
        <p class="service-field__graphic-heading">{visualHeading}</p>

        {state === "connected" && (
          <div class="field-path" aria-label={stateLabel}>
            {visibleCallouts.map((callout, index) => (
              <span class:list={["field-path__node", { "field-path__node--active": index === 1, "field-path__node--verified": index === visibleCallouts.length - 1 }]}>{callout}</span>
            ))}
          </div>
        )}

        {state === "conflict" && (
          <div class="field-interface" aria-label={stateLabel}>
            <div class="field-interface__bar" aria-hidden="true"><i></i><i></i><i></i></div>
            <div class="field-interface__message"><span aria-hidden="true">!</span><strong>{visibleCallouts[0]}</strong></div>
            <div class="field-interface__rows">
              {visibleCallouts.slice(1).map((callout) => <span><i aria-hidden="true"></i>{callout}</span>)}
            </div>
          </div>
        )}

        {state === "dependencies" && (
          <div class="field-dependencies" aria-label={stateLabel}>
            <strong>{stateLabel}</strong>
            {visibleCallouts.map((callout, index) => <span class={`field-dependency field-dependency--${index + 1}`}><i aria-hidden="true"></i>{callout}</span>)}
          </div>
        )}

        {state === "controlled-change" && (
          <div class="field-change" aria-label={stateLabel}>
            {visibleCallouts.map((callout, index) => (
              <div class="field-change__step"><i aria-hidden="true"></i><strong>{callout}</strong>{index < visibleCallouts.length - 1 && <span>{checkpointLabel}</span>}</div>
            ))}
          </div>
        )}

        {state === "verified" && (
          <div class="field-verified" aria-label={stateLabel}>
            <div class="field-verified__mark" aria-hidden="true">✓</div>
            <ul>{visibleCallouts.map((callout) => <li><span aria-hidden="true">✓</span>{callout}</li>)}</ul>
          </div>
        )}

        <span class="service-field__state"><i aria-hidden="true"></i>{stateLabel}</span>
      </div>
    )}
  </div>
  <figcaption class:list={[{ "service-field__caption--hidden": !showCaption }]}>
    <strong id={titleId}>{title}</strong>
    <p>{description}</p>
  </figcaption>
</figure>
