---
type Props = {
  study: { id: string; title: string };
  selected?: boolean;
  surface?: "light" | "dark" | "soft";
};

const { study, selected = false, surface = "light" } = Astro.props;
---

<section id={study.id} class="lab-experiment" aria-label={study.title} hidden={!selected}>
  <div class:list={["section", "lab-composition", { "section--ink": surface === "dark", "section--warm": surface === "soft" }]} lang="de">
    <div class="container"><slot /></div>
  </div>
</section>
