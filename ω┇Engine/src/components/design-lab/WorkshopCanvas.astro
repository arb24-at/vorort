---
import type { AstroComponentFactory } from "astro/runtime/server/index.js";
import { getSectionRecipe, sectionRecipes } from "../../design-system/section-recipes";
import type { WorkshopFixture } from "../../design-system/workshop-schema";
import "../../styles/design-lab/concept-ii.css";
type Props = { fixture: WorkshopFixture; sections?: WorkshopFixture["sections"] };
const { fixture, sections = fixture.sections } = Astro.props;
const renderers = import.meta.glob<AstroComponentFactory>("./sections/*.astro", { eager: true, import: "default" });
for (const [id, recipe] of Object.entries(sectionRecipes)) {
  if (!renderers[`./sections/${recipe.renderer}`]) throw new Error(`Recipe ${id} has no Astro renderer: ${recipe.renderer}`);
}
---
<div class:list={["concept-ii", `concept-ii--${fixture.page.audience}`]} data-workshop-page={fixture.page.id}>
  {sections.map(section => {
    const Renderer = renderers[`./sections/${getSectionRecipe(section.recipe).renderer}`];
    return <Renderer id={section.id} content={section.content} audience={fixture.page.audience} locale={fixture.page.locale} />;
  })}
</div>
