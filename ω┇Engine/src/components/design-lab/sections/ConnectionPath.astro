---
import type { RecipeContent } from "../../../design-system/section-recipes";
import EditorialNote from "../EditorialNote.astro";
type Props = { id: string; content: RecipeContent<"explanation.connection-path"> };
const { id, content } = Astro.props;
---
<section class="pw-connections pw-section" id={id} data-recipe="explanation.connection-path" aria-labelledby={`${id}-title`} tabindex="-1">
  <div class="container">
    <div class="pw-connections__intro">
      <div><p class="pw-eyebrow">{content.eyebrow}</p><h2 id={`${id}-title`}>{content.title}</h2></div>
      <div class="pw-prose">{content.paragraphs.map(paragraph => <p>{paragraph}</p>)}</div>
    </div>
    <figure class="pw-path" aria-labelledby={`${id}-diagram`}>
      <div class="pw-path__header">
        <div>
          <p class="pw-path__kicker">Physical connection path</p>
          <h3 id={`${id}-diagram`}>{content.diagramTitle}</h3>
        </div>
        <p class="pw-path__sequence" aria-hidden="true"><span>01</span> source <b>→</b> <span>02</span> route <b>→</b> <span>03</span> destinations</p>
      </div>
      <div class="pw-path__network">
        <article class="pw-path__node pw-path__node--source">
          <span class="pw-path__step" aria-hidden="true">01</span>
          <svg viewBox="0 0 96 72" class="pw-path__device" aria-hidden="true"><path d="M22 40V12m52 28V12M17 40h62v20H17z"/><path d="M25 50h4m8 0h4m8 0h4" class="pw-path__status"/></svg>
          <h4>{content.source.title}</h4><p>{content.source.body}</p>
        </article>
        <span class="pw-path__connector" aria-hidden="true"><i></i><b>→</b></span>
        <article class="pw-path__node pw-path__node--route">
          <span class="pw-path__step" aria-hidden="true">02</span>
          <svg viewBox="0 0 72 72" class="pw-path__device" aria-hidden="true"><path d="M15 8h42v56H15zM25 23h22v19H25zM31 23v7m5-7v7m5-7v7"/><path d="M36 42v24" class="pw-path__wire"/></svg>
          <h4>{content.route.title}</h4><p>{content.route.body}</p>
        </article>
        <span class="pw-path__connector" aria-hidden="true"><i></i><b>→</b></span>
        <ol class="pw-path__destinations">
          {content.destinations.map((destination, index) => <li>
            <span class="pw-path__destination-number" aria-hidden="true">03.{index + 1}</span>
            <div><h4>{destination.title}</h4><p>{destination.body}</p></div>
          </li>)}
        </ol>
      </div>
      <figcaption><strong>Planning note</strong><span>{content.caption}</span></figcaption>
    </figure>
    {content.note && <EditorialNote {...content.note} />}
  </div>
</section>
