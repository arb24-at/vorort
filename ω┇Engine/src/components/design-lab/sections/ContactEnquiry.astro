---
import { enquiryInterface } from "../../../utils/enquiry-interface";
import { siteConfig } from "../../../data/site";
import { withBase } from "../../../utils/withBase";
import type { Audience, RecipeContent } from "../../../design-system/section-recipes";

type Props = {
  id: string;
  audience: Audience;
  locale: "en" | "de";
  content: RecipeContent<"contact.enquiry"> | RecipeContent<"contact.enquiry-email">;
  recipeId?: "contact.enquiry" | "contact.enquiry-email";
  source?: string;
};

const { id, audience, locale = "en", content, recipeId = "contact.enquiry", source = `workshop:${id}` } = Astro.props;
const ui = enquiryInterface(locale);
const emailDraft = recipeId === "contact.enquiry-email";
const emailSubject = "emailSubject" in content ? content.emailSubject : ui.subject;
const copy = {
  title: content.title ?? ui.defaultTitle,
  intro: content.intro ?? ui.defaultIntro,
  formIntro: content.formIntro ?? ui.defaultFormIntro,
  affectedPlaceholder: content.affectedPlaceholder ?? ui.defaultAffected,
  request: content.request ?? ui.defaultRequest,
  requestPlaceholder: content.requestPlaceholder ?? ui.defaultRequestPlaceholder,
};
const formEndpoint = import.meta.env.PUBLIC_CONTACT_FORM_ENDPOINT?.trim() ?? "";
const customerContext = audience === "business" ? "Business" : audience === "private" ? "Private" : "General";
const privacyHref = withBase(locale === "en" ? "/en/privacy/" : "/datenschutz/");
---
<section class:list={["c2-contact", { "c2-contact--email": emailDraft }]} id={id} data-recipe={recipeId} aria-labelledby={`${id}-title`}>
  <div class="container">
    <div class="c2-contact__shell">
      <div class="c2-contact__intro">
        <span class="c2-eyebrow">{ui.eyebrow}</span>
        <h2 id={`${id}-title`}>{copy.title}</h2>
        <p class="c2-contact__lede">{copy.intro}</p>

        <div class="c2-contact__journey">
          <p class="c2-contact__journey-label">{ui.journey}</p>
          <ol>
            <li><span aria-hidden="true">01</span><strong>{ui.step1}</strong></li>
            <li><span aria-hidden="true">02</span><strong>{ui.step2}</strong></li>
            <li><span aria-hidden="true">03</span><strong>{ui.step3}</strong></li>
          </ol>
        </div>

        <div class="c2-contact__channels" aria-label={ui.channels}>
          <a href={siteConfig.contact.phoneHref}>
            <span class="c2-contact__channel-icon" aria-hidden="true">
              <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><path d="M22 16.92v3a2 2 0 0 1-2.18 2A19.79 19.79 0 0 1 3 5.18 2 2 0 0 1 5 3h3a2 2 0 0 1 2 1.72c.12.96.35 1.9.68 2.79a2 2 0 0 1-.45 2.11L9 10.85a16 16 0 0 0 4.15 4.15l1.23-1.23a2 2 0 0 1 2.11-.45c.89.33 1.83.56 2.79.68A2 2 0 0 1 22 16.92Z"/></svg>
            </span>
            <span class="c2-contact__channel-copy"><small>{ui.call}</small><strong>{siteConfig.contact.phoneDisplay}</strong></span>
            <span class="c2-contact__channel-action" aria-hidden="true">↗</span>
          </a>
          <a href={siteConfig.contact.whatsappHref}>
            <span class="c2-contact__channel-icon" aria-hidden="true">
              <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><path d="M21 11.5a8.5 8.5 0 0 1-8.5 8.5 9 9 0 0 1-4-.95L3 21l1.95-5.5A9 9 0 0 1 4 11.5 8.5 8.5 0 1 1 21 11.5Z"/><path d="M9 9.5c1 2 2 3 4.5 4.5l1.5-1"/></svg>
            </span>
            <span class="c2-contact__channel-copy"><small>WhatsApp</small><strong>{siteConfig.contact.phoneDisplay}</strong></span>
            <span class="c2-contact__channel-action" aria-hidden="true">↗</span>
          </a>
          <a class="c2-contact__channel-email" href={`mailto:${siteConfig.contact.email}`}>
            <span class="c2-contact__channel-icon" aria-hidden="true">
              <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><rect x="3" y="5" width="18" height="14" rx="2"/><path d="m3 7 9 6 9-6"/></svg>
            </span>
            <span class="c2-contact__channel-copy"><small>{ui.email}</small><strong>{siteConfig.contact.email}</strong></span>
            <span class="c2-contact__channel-action" aria-hidden="true">↗</span>
          </a>
        </div>
      </div>

      <div class="c2-contact__form-panel">
        <div class="c2-contact__form-head">
          <span class="c2-kicker">{ui.form}</span>
          <h3>{emailDraft ? ui.prepare : formEndpoint ? ui.sendHeading : ui.previewHeading}</h3>
          <p>{copy.formIntro}</p>
        </div>

        <form
          class="c2-contact__form"
          action={emailDraft ? `mailto:${siteConfig.contact.email}` : formEndpoint || undefined}
          method="post"
          enctype={emailDraft ? "text/plain" : undefined}
          data-contact-form
          data-locale={locale}
          data-endpoint={formEndpoint}
          data-delivery={emailDraft ? "email" : "direct"}
          data-email={emailDraft ? siteConfig.contact.email : undefined}
          data-subject={emailDraft ? emailSubject : undefined}
          novalidate
        >
          <input type="hidden" name="context" value={customerContext} />
          {!emailDraft && <input type="hidden" name="source" value={source} />}

          <div class="c2-contact__form-grid">
            <label>
              <span>{ui.name} <b class="c2-contact__required" aria-hidden="true">*</b></span>
              <input type="text" name="name" autocomplete="name" placeholder={ui.namePlaceholder} required />
              <small class="c2-contact__error" data-error-for="name" aria-live="polite"></small>
            </label>
            <label>
              <span>{ui.preferred} <b class="c2-contact__required" aria-hidden="true">*</b></span>
              <select name="preferred-contact" required>
                <option value="Email">{ui.email}</option>
                <option value="Phone">{ui.phone}</option>
                <option value="WhatsApp">WhatsApp</option>
              </select>
              <small class="c2-contact__error" data-error-for="preferred-contact" aria-live="polite"></small>
            </label>
            <label class="c2-contact__field-wide" data-contact-email>
              <span>{ui.email} <b class="c2-contact__required" data-email-required aria-hidden="true">*</b></span>
              <input type="email" name="email" autocomplete="email" placeholder={ui.emailPlaceholder} required />
              <small class="c2-contact__error" data-error-for="email" aria-live="polite"></small>
            </label>
            <label class="c2-contact__field-wide" data-contact-phone hidden>
              <span>{ui.phoneNumber} <b class="c2-contact__required" data-phone-required aria-hidden="true">*</b></span>
              <input type="tel" name="phone" autocomplete="tel" placeholder={ui.phonePlaceholder} disabled />
              <small class="c2-contact__error" data-error-for="phone" aria-live="polite"></small>
            </label>
            <label class="c2-contact__field-wide">
              <span>{copy.request} <b class="c2-contact__required" aria-hidden="true">*</b></span>
              <textarea name="request" rows={emailDraft ? "5" : "4"} minlength="10" placeholder={copy.requestPlaceholder} required></textarea>
              <small class="c2-contact__error" data-error-for="request" aria-live="polite"></small>
            </label>
          </div>

          <details class="c2-contact__optional">
            <summary><span>{ui.details}</span><span class="c2-contact__optional-chevron" aria-hidden="true">⌄</span></summary>
            <div class="c2-contact__form-grid c2-contact__optional-grid">
              <label>
                <span>{ui.postcode} <small>{ui.optional}</small></span>
                <input type="text" name="postcode" autocomplete="postal-code" placeholder={ui.postcodePlaceholder} />
                <small class="c2-contact__error" data-error-for="postcode" aria-live="polite"></small>
              </label>
              {audience === "business" ? (
                <label>
                  <span>{ui.company} <small>{ui.optional}</small></span>
                  <input type="text" name="company" autocomplete="organization" />
                  <small class="c2-contact__error" data-error-for="company" aria-live="polite"></small>
                </label>
              ) : (
                <label>
                  <span>{ui.appointment} <small>{ui.optional}</small></span>
                  <input type="text" name="appointment-period" placeholder={ui.appointmentPlaceholder} />
                  <small class="c2-contact__error" data-error-for="appointment-period" aria-live="polite"></small>
                </label>
              )}
              <label class="c2-contact__field-wide">
                <span>{ui.affected} <small>{ui.optional}</small></span>
                <input type="text" name="affected" placeholder={copy.affectedPlaceholder} />
                <small class="c2-contact__error" data-error-for="affected" aria-live="polite"></small>
              </label>
              {audience === "business" && (
                <label class="c2-contact__field-wide">
                  <span>{ui.appointment} <small>{ui.optional}</small></span>
                  <input type="text" name="appointment-period" placeholder={ui.appointmentPlaceholder} />
                  <small class="c2-contact__error" data-error-for="appointment-period" aria-live="polite"></small>
                </label>
              )}
            </div>
          </details>

          <div class="c2-contact__safety">
            <span aria-hidden="true">!</span>
            <p>{ui.safety}</p>
          </div>

          <p class="c2-contact__privacy">{ui.privacy} <a href={privacyHref}>{ui.privacyLink}</a>.</p>

          <button class="c2-contact__submit" type="submit" disabled={!emailDraft && !formEndpoint} aria-describedby={`${id}-delivery-status`}>
            <span data-submit-label>{emailDraft ? ui.draftButton : ui.sendButton}</span>
            <span aria-hidden="true">→</span>
          </button>
          <p class="c2-contact__status" id={`${id}-delivery-status`} data-form-status role="status" aria-live="polite">{emailDraft ? ui.draftStatus : !formEndpoint && ui.previewStatus}</p>
        </form>
      </div>
    </div>
  </div>
</section>

<script>
  import { enquiryEmailHref } from "../../../utils/enquiry-email";
  import { enquiryInterface, enquiryFieldError } from "../../../utils/enquiry-interface";
  document.querySelectorAll<HTMLFormElement>("[data-contact-form]").forEach((form) => {
    const locale = form.dataset.locale === "de" ? "de" : "en";
    const ui = enquiryInterface(locale);
    const endpoint = form.dataset.endpoint?.trim() ?? "";
    const status = form.querySelector<HTMLElement>("[data-form-status]");
    const submit = form.querySelector<HTMLButtonElement>("button[type='submit']");
    const submitLabel = form.querySelector<HTMLElement>("[data-submit-label]");
    const preferred = form.elements.namedItem("preferred-contact") as HTMLSelectElement | null;
    const email = form.elements.namedItem("email") as HTMLInputElement | null;
    const phone = form.elements.namedItem("phone") as HTMLInputElement | null;
    const emailRequired = form.querySelector<HTMLElement>("[data-email-required]");
    const phoneRequired = form.querySelector<HTMLElement>("[data-phone-required]");
    const emailGroup = form.querySelector<HTMLElement>("[data-contact-email]");
    const phoneGroup = form.querySelector<HTMLElement>("[data-contact-phone]");

    const setStatus = (message: string, state: "idle" | "success" | "error" = "idle") => {
      if (!status) return;
      status.textContent = message;
      status.dataset.state = state;
    };

    const errorNodeFor = (field: HTMLInputElement | HTMLSelectElement | HTMLTextAreaElement) =>
      form.querySelector<HTMLElement>(`[data-error-for="${field.name}"]`);

    const clearFieldError = (field: HTMLInputElement | HTMLSelectElement | HTMLTextAreaElement) => {
      field.removeAttribute("aria-invalid");
      const error = errorNodeFor(field);
      if (error) error.textContent = "";
    };

    const showFieldError = (field: HTMLInputElement | HTMLSelectElement | HTMLTextAreaElement) => {
      field.setAttribute("aria-invalid", "true");
      const error = errorNodeFor(field);
      if (error) error.textContent = enquiryFieldError(locale, field.validity, field.validationMessage, "minLength" in field ? field.minLength : 0);
    };

    const syncContactRequirement = () => {
      if (!preferred || !email || !phone) return;
      const needsEmail = preferred.value === "Email";
      const needsPhone = preferred.value === "Phone" || preferred.value === "WhatsApp";

      email.required = needsEmail;
      phone.required = needsPhone;
      email.disabled = !needsEmail;
      phone.disabled = !needsPhone;
      if (emailGroup) emailGroup.hidden = !needsEmail;
      if (phoneGroup) phoneGroup.hidden = !needsPhone;
      email.setCustomValidity(needsEmail && !email.value.trim() ? ui.emailRequired : "");
      phone.setCustomValidity(needsPhone && !phone.value.trim() ? ui.phoneRequired : "");

      if (emailRequired) emailRequired.hidden = !needsEmail;
      if (phoneRequired) phoneRequired.hidden = !needsPhone;
      if (!needsEmail) clearFieldError(email);
      if (!needsPhone) clearFieldError(phone);
    };

    preferred?.addEventListener("change", () => {
      syncContactRequirement();
      clearFieldError(preferred);
    });
    email?.addEventListener("input", () => {
      syncContactRequirement();
      if (email.checkValidity()) clearFieldError(email);
    });
    phone?.addEventListener("input", () => {
      syncContactRequirement();
      if (phone.checkValidity()) clearFieldError(phone);
    });

    form.querySelectorAll<HTMLInputElement | HTMLSelectElement | HTMLTextAreaElement>("input:not([type='hidden']), select, textarea").forEach((field) => {
      field.addEventListener("input", () => {
        if (field.checkValidity()) clearFieldError(field);
      });
      field.addEventListener("change", () => {
        if (field.checkValidity()) clearFieldError(field);
      });
    });

    form.addEventListener("submit", async (event) => {
      event.preventDefault();
      setStatus("");
      syncContactRequirement();

      const fields = Array.from(form.querySelectorAll<HTMLInputElement | HTMLSelectElement | HTMLTextAreaElement>("input:not([type='hidden']), select, textarea"));
      let firstInvalid: HTMLInputElement | HTMLSelectElement | HTMLTextAreaElement | null = null;
      fields.forEach((field) => {
        if (field.checkValidity()) clearFieldError(field);
        else {
          showFieldError(field);
          firstInvalid ??= field;
        }
      });

      if (firstInvalid) {
        setStatus(ui.invalid, "error");
        firstInvalid.focus();
        return;
      }

      if (form.dataset.delivery === "email") {
        const entries = Array.from(new FormData(form).entries()).filter((entry): entry is [string, string] => typeof entry[1] === "string");
        window.location.href = enquiryEmailHref(form.dataset.email!, form.dataset.subject!, entries, locale);
        setStatus(ui.draftOpened);
        return;
      }

      if (!endpoint) {
        setStatus(ui.disconnected, "error");
        return;
      }

      const idleLabel = submitLabel?.textContent ?? ui.sendButton;
      if (submit) submit.disabled = true;
      if (submitLabel) submitLabel.textContent = ui.sending;

      try {
        const response = await fetch(endpoint, {
          method: "POST",
          body: new FormData(form),
          headers: { Accept: "application/json" },
        });
        if (!response.ok) throw new Error(`Form endpoint returned ${response.status}`);

        form.reset();
        syncContactRequirement();
        fields.forEach(clearFieldError);
        setStatus(ui.success, "success");
      } catch {
        setStatus(ui.failed, "error");
      } finally {
        if (submit) submit.disabled = false;
        if (submitLabel) submitLabel.textContent = idleLabel;
      }
    });

    syncContactRequirement();
  });
</script>
