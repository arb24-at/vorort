---
import ContactSection from "../../ContactSection.astro";
import type { Audience, RecipeContent } from "../../../design-system/section-recipes";
type Props = { audience: Audience; locale: "en"; content: RecipeContent<"contact.enquiry"> };
const { audience, locale, content } = Astro.props;
---
<div data-recipe="contact.enquiry">
  <ContactSection locale={locale} context={audience} copyOverrides={content} />
</div>
