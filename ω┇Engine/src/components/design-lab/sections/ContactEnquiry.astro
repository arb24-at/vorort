---
import { siteConfig } from "../../../data/site";
import { withBase } from "../../../utils/withBase";
import type { Audience, RecipeContent } from "../../../design-system/section-recipes";

type Props = {
  id: string;
  audience: Audience;
  locale: "en";
  content: RecipeContent<"contact.enquiry">;
};

const { id, audience, content } = Astro.props;
const copy = {
  title: content.title ?? "Let’s talk about your IT needs",
  intro: content.intro ?? "Tell us what you need help with. A short description is enough.",
  formIntro: content.formIntro ?? "Just a few details so we can reply. * Required fields.",
  affectedPlaceholder: content.affectedPlaceholder ?? "For example Wi-Fi, a laptop, Microsoft 365 or a new setup",
  request: content.request ?? "What do you need help with?",
  requestPlaceholder: content.requestPlaceholder ?? "Describe what is happening, what should work, and anything important we should know before replying.",
};
const formEndpoint = import.meta.env.PUBLIC_CONTACT_FORM_ENDPOINT?.trim() ?? "";
const customerContext = audience === "business" ? "Business" : "Private";
const privacyHref = withBase("/datenschutz/");
---
<section class="c2-contact" id={id} data-recipe="contact.enquiry">
  <div class="container">
    <div class="c2-contact__shell">
      <div class="c2-contact__intro">
        <span class="c2-eyebrow">Start a conversation</span>
        <h2>{copy.title}</h2>
        <p class="c2-contact__lede">{copy.intro}</p>

        <div class="c2-contact__journey">
          <p class="c2-contact__journey-label">A straightforward start</p>
          <ol>
            <li><span aria-hidden="true">01</span><strong>Share your situation</strong></li>
            <li><span aria-hidden="true">02</span><strong>Clarify the details</strong></li>
            <li><span aria-hidden="true">03</span><strong>Discuss next steps</strong></li>
          </ol>
        </div>

        <div class="c2-contact__channels" aria-label="Direct contact options">
          <a href={siteConfig.contact.phoneHref}>
            <span class="c2-contact__channel-icon" aria-hidden="true">
              <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><path d="M22 16.92v3a2 2 0 0 1-2.18 2A19.79 19.79 0 0 1 3 5.18 2 2 0 0 1 5 3h3a2 2 0 0 1 2 1.72c.12.96.35 1.9.68 2.79a2 2 0 0 1-.45 2.11L9 10.85a16 16 0 0 0 4.15 4.15l1.23-1.23a2 2 0 0 1 2.11-.45c.89.33 1.83.56 2.79.68A2 2 0 0 1 22 16.92Z"/></svg>
            </span>
            <span class="c2-contact__channel-copy"><small>Call</small><strong>{siteConfig.contact.phoneDisplay}</strong></span>
            <span class="c2-contact__channel-action" aria-hidden="true">↗</span>
          </a>
          <a href={siteConfig.contact.whatsappHref}>
            <span class="c2-contact__channel-icon" aria-hidden="true">
              <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><path d="M21 11.5a8.5 8.5 0 0 1-8.5 8.5 9 9 0 0 1-4-.95L3 21l1.95-5.5A9 9 0 0 1 4 11.5 8.5 8.5 0 1 1 21 11.5Z"/><path d="M9 9.5c1 2 2 3 4.5 4.5l1.5-1"/></svg>
            </span>
            <span class="c2-contact__channel-copy"><small>WhatsApp</small><strong>{siteConfig.contact.phoneDisplay}</strong></span>
            <span class="c2-contact__channel-action" aria-hidden="true">↗</span>
          </a>
          <a class="c2-contact__channel-email" href={`mailto:${siteConfig.contact.email}`}>
            <span class="c2-contact__channel-icon" aria-hidden="true">
              <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><rect x="3" y="5" width="18" height="14" rx="2"/><path d="m3 7 9 6 9-6"/></svg>
            </span>
            <span class="c2-contact__channel-copy"><small>Email</small><strong>{siteConfig.contact.email}</strong></span>
            <span class="c2-contact__channel-action" aria-hidden="true">↗</span>
          </a>
        </div>
      </div>

      <div class="c2-contact__form-panel">
        <div class="c2-contact__form-head">
          <span class="c2-kicker">Enquiry form</span>
          <h3>Send an enquiry</h3>
          <p>{copy.formIntro}</p>
        </div>

        <form
          class="c2-contact__form"
          action={formEndpoint || undefined}
          method="post"
          data-contact-form
          data-endpoint={formEndpoint}
          novalidate
        >
          <input type="hidden" name="context" value={customerContext} />
          <input type="hidden" name="source" value={`workshop:${id}`} />

          <div class="c2-contact__form-grid">
            <label>
              <span>Name <b class="c2-contact__required" aria-hidden="true">*</b></span>
              <input type="text" name="name" autocomplete="name" placeholder="Your name" required />
              <small class="c2-contact__error" data-error-for="name" aria-live="polite"></small>
            </label>
            <label>
              <span>Preferred contact <b class="c2-contact__required" aria-hidden="true">*</b></span>
              <select name="preferred-contact" required>
                <option value="Email">Email</option>
                <option value="Phone">Phone</option>
                <option value="WhatsApp">WhatsApp</option>
              </select>
              <small class="c2-contact__error" data-error-for="preferred-contact" aria-live="polite"></small>
            </label>
            <label class="c2-contact__field-wide" data-contact-email>
              <span>Email <b class="c2-contact__required" data-email-required aria-hidden="true">*</b></span>
              <input type="email" name="email" autocomplete="email" placeholder="you@example.com" required />
              <small class="c2-contact__error" data-error-for="email" aria-live="polite"></small>
            </label>
            <label class="c2-contact__field-wide" data-contact-phone hidden>
              <span>Phone number <b class="c2-contact__required" data-phone-required aria-hidden="true">*</b></span>
              <input type="tel" name="phone" autocomplete="tel" placeholder="For example +49 …" disabled />
              <small class="c2-contact__error" data-error-for="phone" aria-live="polite"></small>
            </label>
            <label class="c2-contact__field-wide">
              <span>{copy.request} <b class="c2-contact__required" aria-hidden="true">*</b></span>
              <textarea name="request" rows="4" minlength="10" placeholder={copy.requestPlaceholder} required></textarea>
              <small class="c2-contact__error" data-error-for="request" aria-live="polite"></small>
            </label>
          </div>

          <details class="c2-contact__optional">
            <summary><span>Add details (optional)</span><span class="c2-contact__optional-chevron" aria-hidden="true">⌄</span></summary>
            <div class="c2-contact__form-grid c2-contact__optional-grid">
              <label>
                <span>Postcode or district <small>optional</small></span>
                <input type="text" name="postcode" autocomplete="postal-code" placeholder="For example 10999 or Kreuzberg" />
                <small class="c2-contact__error" data-error-for="postcode" aria-live="polite"></small>
              </label>
              {audience === "business" ? (
                <label>
                  <span>Company name <small>optional</small></span>
                  <input type="text" name="company" autocomplete="organization" />
                  <small class="c2-contact__error" data-error-for="company" aria-live="polite"></small>
                </label>
              ) : (
                <label>
                  <span>Preferred appointment period <small>optional</small></span>
                  <input type="text" name="appointment-period" placeholder="For example weekday evening or Saturday" />
                  <small class="c2-contact__error" data-error-for="appointment-period" aria-live="polite"></small>
                </label>
              )}
              <label class="c2-contact__field-wide">
                <span>Affected device or service <small>optional</small></span>
                <input type="text" name="affected" placeholder={copy.affectedPlaceholder} />
                <small class="c2-contact__error" data-error-for="affected" aria-live="polite"></small>
              </label>
              {audience === "business" && (
                <label class="c2-contact__field-wide">
                  <span>Preferred appointment period <small>optional</small></span>
                  <input type="text" name="appointment-period" placeholder="For example weekday evening or Saturday" />
                  <small class="c2-contact__error" data-error-for="appointment-period" aria-live="polite"></small>
                </label>
              )}
            </div>
          </details>

          <div class="c2-contact__safety">
            <span aria-hidden="true">!</span>
            <p>Never send passwords, authentication or recovery codes, payment-card details or remote-access credentials.</p>
          </div>

          <p class="c2-contact__privacy">Details submitted here are used to respond to your enquiry. <a href={privacyHref}>Privacy policy (German)</a>.</p>

          <button class="c2-contact__submit" type="submit">
            <span data-submit-label>Send enquiry</span>
            <span aria-hidden="true">→</span>
          </button>
          <p class="c2-contact__status" data-form-status role="status" aria-live="polite"></p>
        </form>
      </div>
    </div>
  </div>
</section>

<script>
  document.querySelectorAll<HTMLFormElement>("[data-contact-form]").forEach((form) => {
    const endpoint = form.dataset.endpoint?.trim() ?? "";
    const status = form.querySelector<HTMLElement>("[data-form-status]");
    const submit = form.querySelector<HTMLButtonElement>("button[type='submit']");
    const submitLabel = form.querySelector<HTMLElement>("[data-submit-label]");
    const preferred = form.elements.namedItem("preferred-contact") as HTMLSelectElement | null;
    const email = form.elements.namedItem("email") as HTMLInputElement | null;
    const phone = form.elements.namedItem("phone") as HTMLInputElement | null;
    const emailRequired = form.querySelector<HTMLElement>("[data-email-required]");
    const phoneRequired = form.querySelector<HTMLElement>("[data-phone-required]");
    const emailGroup = form.querySelector<HTMLElement>("[data-contact-email]");
    const phoneGroup = form.querySelector<HTMLElement>("[data-contact-phone]");

    const setStatus = (message: string, state: "idle" | "success" | "error" = "idle") => {
      if (!status) return;
      status.textContent = message;
      status.dataset.state = state;
    };

    const errorNodeFor = (field: HTMLInputElement | HTMLSelectElement | HTMLTextAreaElement) =>
      form.querySelector<HTMLElement>(`[data-error-for="${field.name}"]`);

    const clearFieldError = (field: HTMLInputElement | HTMLSelectElement | HTMLTextAreaElement) => {
      field.removeAttribute("aria-invalid");
      const error = errorNodeFor(field);
      if (error) error.textContent = "";
    };

    const showFieldError = (field: HTMLInputElement | HTMLSelectElement | HTMLTextAreaElement) => {
      field.setAttribute("aria-invalid", "true");
      const error = errorNodeFor(field);
      if (error) error.textContent = field.validationMessage;
    };

    const syncContactRequirement = () => {
      if (!preferred || !email || !phone) return;
      const needsEmail = preferred.value === "Email";
      const needsPhone = preferred.value === "Phone" || preferred.value === "WhatsApp";

      email.required = needsEmail;
      phone.required = needsPhone;
      email.disabled = !needsEmail;
      phone.disabled = !needsPhone;
      if (emailGroup) emailGroup.hidden = !needsEmail;
      if (phoneGroup) phoneGroup.hidden = !needsPhone;
      email.setCustomValidity(needsEmail && !email.value.trim() ? "Add an email address if you prefer email." : "");
      phone.setCustomValidity(needsPhone && !phone.value.trim() ? "Add a phone number if you prefer phone or WhatsApp." : "");

      if (emailRequired) emailRequired.hidden = !needsEmail;
      if (phoneRequired) phoneRequired.hidden = !needsPhone;
      if (!needsEmail) clearFieldError(email);
      if (!needsPhone) clearFieldError(phone);
    };

    preferred?.addEventListener("change", () => {
      syncContactRequirement();
      clearFieldError(preferred);
    });
    email?.addEventListener("input", () => {
      syncContactRequirement();
      if (email.checkValidity()) clearFieldError(email);
    });
    phone?.addEventListener("input", () => {
      syncContactRequirement();
      if (phone.checkValidity()) clearFieldError(phone);
    });

    form.querySelectorAll<HTMLInputElement | HTMLSelectElement | HTMLTextAreaElement>("input:not([type='hidden']), select, textarea").forEach((field) => {
      field.addEventListener("input", () => {
        if (field.checkValidity()) clearFieldError(field);
      });
      field.addEventListener("change", () => {
        if (field.checkValidity()) clearFieldError(field);
      });
    });

    form.addEventListener("submit", async (event) => {
      event.preventDefault();
      setStatus("");
      syncContactRequirement();

      const fields = Array.from(form.querySelectorAll<HTMLInputElement | HTMLSelectElement | HTMLTextAreaElement>("input:not([type='hidden']), select, textarea"));
      let firstInvalid: HTMLInputElement | HTMLSelectElement | HTMLTextAreaElement | null = null;
      fields.forEach((field) => {
        if (field.checkValidity()) clearFieldError(field);
        else {
          showFieldError(field);
          firstInvalid ??= field;
        }
      });

      if (firstInvalid) {
        setStatus("Please check the highlighted fields.", "error");
        firstInvalid.focus();
        return;
      }

      if (!endpoint) {
        setStatus("Direct form delivery is not connected in this Design Lab build yet. Please use phone, WhatsApp or email for now.", "error");
        return;
      }

      const idleLabel = submitLabel?.textContent ?? "Send enquiry";
      if (submit) submit.disabled = true;
      if (submitLabel) submitLabel.textContent = "Sending…";

      try {
        const response = await fetch(endpoint, {
          method: "POST",
          body: new FormData(form),
          headers: { Accept: "application/json" },
        });
        if (!response.ok) throw new Error(`Form endpoint returned ${response.status}`);

        form.reset();
        syncContactRequirement();
        fields.forEach(clearFieldError);
        setStatus("Thanks — your enquiry has been sent. We will reply using your preferred contact method.", "success");
      } catch {
        setStatus("We could not send your enquiry. Please try again or use phone, WhatsApp or email.", "error");
      } finally {
        if (submit) submit.disabled = false;
        if (submitLabel) submitLabel.textContent = idleLabel;
      }
    });

    syncContactRequirement();
  });
</script>
