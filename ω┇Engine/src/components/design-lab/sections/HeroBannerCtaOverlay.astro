---
import type { RecipeContent } from "../../../design-system/section-recipes";
import { withBase } from "../../../utils/withBase";
import ArtField from "../ArtField.astro";
type Props = { anchorBase?: string; id: string; headingTag?: "h1" | "h2"; content: RecipeContent<"comparison.hero-banner-cta-overlay"> };
const { id, content, headingTag = "h1" } = Astro.props;
const Heading = headingTag;
const { eyebrow, title, intro, media, actions } = content;
const heroImageSrc = media.src ? withBase(media.src) : undefined;
const heroArtLabel = media.alt;
const heroKind = media.subject;
const anchorBase = Astro.props.anchorBase;
---

<section class="c2-hero c2-hero--cta-overlay-only" id={id} data-recipe="comparison.hero-banner-cta-overlay">
  <div class="container">
    <div class:list={["c2-hero__banner", { "c2-hero__banner--with-image": Boolean(heroImageSrc) }]}>
      <div class="c2-hero__copy">
        <span class="c2-eyebrow">{eyebrow}</span>
        <Heading>{title}</Heading>
        <div class="c2-hero__intro-above">
          <p>{intro}</p>
        </div>
      </div>

      <div class="c2-hero__visual">
        <div
          class:list={[
            "c2-art",
            "c2-art--hero",
            `c2-art--${heroKind}`,
            { "c2-art--has-image": Boolean(heroImageSrc) }
          ]}
          aria-label={heroArtLabel}
          role="img"
        >
          {heroImageSrc ? (
            <img
              class="c2-art__image"
              src={heroImageSrc}
              alt=""
              aria-hidden="true"
              loading="eager"
              decoding="async"
              fetchpriority="high"
            />
          ) : (
            <>
              <ArtField />
              <span class="c2-art__caption">Artwork placeholder · {heroArtLabel}</span>
            </>
          )}
        </div>

        <div class="c2-hero__actions-only">
          <div class="c2-hero__actions">
            <a class="c2-button c2-button--signal" href={`${anchorBase ?? ""}#${actions[0].target}`}>
              <span>{actions[0].label}</span><b aria-hidden="true">↗</b>
            </a>
            <a class="c2-button c2-button--ghost" href={`${anchorBase ?? ""}#${actions[1].target}`}>
              <span>{actions[1].label}</span><b aria-hidden="true">↓</b>
            </a>
          </div>
        </div>
      </div>
    </div>
  </div>
</section>
