---
import "../styles/tokens.css";
import "../styles/global.css";
import "../styles/technical-field.css";
import Header from "../components/Header.astro";
import RecipeSection from "../components/RecipeSection.astro";
import { siteFooterSection } from "../data/site-shell";
import MobileContactDock from "../components/MobileContactDock.astro";
import { siteConfig } from "../data/site";
import { withBase } from "../utils/withBase";

type Props = {
  title: string;
  description?: string;
  canonicalPath?: string;
  lang?: "de" | "en";
  alternatePath?: string;
  robots?: string;
  redirectPath?: string;
  showSiteChrome?: boolean;
  // Base-free destination for pages which deliberately have no local enquiry.
  contactPath?: string;
};

const {
  title,
  description = siteConfig.defaultDescription,
  canonicalPath = "",
  lang = "de",
  alternatePath,
  robots,
  redirectPath,
  showSiteChrome = true,
  contactPath
} = Astro.props;

const isExternalCanonical =
  canonicalPath.startsWith("http://") || canonicalPath.startsWith("https://");
const normalizedCanonicalPath = isExternalCanonical
  ? canonicalPath
  : withBase(canonicalPath);
const canonicalUrl = isExternalCanonical
  ? normalizedCanonicalPath
  : new URL(normalizedCanonicalPath, Astro.site ?? "https://www.berlin-tech-support.de")
      .toString();
const alternateUrl = alternatePath !== undefined
  ? new URL(withBase(alternatePath), Astro.site ?? "https://www.berlin-tech-support.de").toString()
  : undefined;
const alternateLang = lang === "de" ? "en" : "de";
const defaultUrl = new URL(withBase(""), Astro.site ?? "https://www.berlin-tech-support.de").toString();
const redirectUrl = redirectPath ? withBase(redirectPath) : undefined;
const contactHref = contactPath !== undefined ? withBase(contactPath) : undefined;
---

<!doctype html>
<html lang={lang}>
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    {robots && <meta name="robots" content={robots} />}
    {redirectUrl && <meta http-equiv="refresh" content={`0; url=${redirectUrl}`} />}
    <link rel="canonical" href={canonicalUrl} />
    {alternateUrl && <link rel="alternate" hreflang={alternateLang} href={alternateUrl} />}
    {alternateUrl && <link rel="alternate" hreflang={lang} href={canonicalUrl} />}
    {alternateUrl && <link rel="alternate" hreflang="x-default" href={defaultUrl} />}
    <meta property="og:type" content="website" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonicalUrl} />
    <meta name="theme-color" content="#17373b" />
  </head>
  <body>
    <a class="skip-link" href="#main-content">{lang === "en" ? "Skip to content" : "Zum Inhalt springen"}</a>
    {showSiteChrome && <Header currentPath={Astro.url.pathname} locale={lang} alternatePath={alternatePath} contactHref={contactHref} />}
    <main id="main-content">
      <slot />
    </main>
    {showSiteChrome && <RecipeSection section={siteFooterSection} audience="general" locale={lang} context="production" />}
    {showSiteChrome && <MobileContactDock locale={lang} contactHref={contactHref} />}
  </body>
</html>
