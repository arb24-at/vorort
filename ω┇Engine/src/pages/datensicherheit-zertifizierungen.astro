---
import MainLayout from "../layouts/MainLayout.astro";
import { siteConfig } from "../data/site";
import { withBase } from "../utils/withBase";
---

<MainLayout
  title={`Sicherer Umgang mit IT-Systemen | ${siteConfig.defaultTitleSuffix}`}
  description="Nachvollziehbarer Umgang mit Zugriffen, Änderungen und sensiblen Informationen beim IT-Service in Berlin."
  canonicalPath="datensicherheit-zertifizierungen/"
>
  <section class="page-intro">
    <div class="container">
      <span class="eyebrow">Sicherheit & Vertrauen</span>
      <h1 class="section-title">Sicherer Umgang mit IT-Systemen</h1>
      <p class="section-lead">
        IT-Support kann Zugriff auf Geräte, Konten und persönliche oder geschäftliche Informationen
        erfordern. Deshalb klären wir Zweck, Umfang und notwendige Zugriffe so verständlich wie möglich.
      </p>
    </div>
  </section>

  <section class="section">
    <div class="container two-grid">
      <article class="card">
        <h2 style="margin-top: 0;">Nur notwendige Zugriffe</h2>
        <p>
          Nicht jede Anfrage erfordert Zugriff auf alle Daten oder Administrationsbereiche. Wir
          grenzen den benötigten Arbeitsbereich gemeinsam mit Ihnen ein.
        </p>
        <ul>
          <li>Keine Passwörter oder Anmeldecodes im Anfrageformular</li>
          <li>Zugriff erst im passenden Arbeitskontext</li>
          <li>Abstimmung vor weitergehenden Änderungen</li>
        </ul>
      </article>

      <article class="card">
        <h2 style="margin-top: 0;">Änderungen nachvollziehbar halten</h2>
        <p>
          Bei technischen Eingriffen sollen Sie verstehen können, was geändert wurde, weshalb es
          erforderlich war und ob weitere Schritte sinnvoll sind.
        </p>
        <ul>
          <li>Transparente Kommunikation zu Zugriffen und Änderungen</li>
          <li>Funktionskontrolle nach der Arbeit</li>
          <li>Empfehlungen ohne unangekündigte Zusatzarbeiten</li>
        </ul>
      </article>
    </div>
  </section>

  <section class="section section-soft">
    <div class="container two-grid">
      <section>
        <span class="eyebrow">Qualifikationen</span>
        <h2 class="section-title">Nachweise erst nach sorgfältiger Prüfung</h2>
        <p class="section-lead">
          Relevante berufliche Qualifikationen und Zertifikate werden derzeit gesammelt und geprüft.
          Wir veröffentlichen erst dann genaue Namen oder Badges, wenn der Nachweis verifiziert ist.
        </p>
      </section>

      <aside class="feature-rail">
        <h3 style="margin-top: 0;">Was wir heute verlässlich sagen können</h3>
        <ul>
          <li>Professionelle IT-Erfahrung seit 2008</li>
          <li>Praxis mit Windows, Microsoft 365 und Google Workspace</li>
          <li>Erfahrung mit Netzwerken, Arbeitsplatz-IT und Softwareproblemen</li>
          <li>Technischer Service auf Englisch</li>
        </ul>
      </aside>
    </div>
  </section>

  <section class="section">
    <div class="container">
      <div class="feature-rail">
        <h2 style="margin-top: 0;">Sicherheitsanforderungen direkt besprechen</h2>
        <p>
          Beschreiben Sie kurz die betroffenen Geräte, Konten oder Arbeitsabläufe. Wir prüfen, ob
          und in welchem Rahmen wir die Anfrage verantwortungsvoll unterstützen können.
        </p>
        <div class="btn-row">
          <a class="btn btn-primary" href={withBase("#kontakt")}>IT-Hilfe anfragen</a>
          <a class="btn btn-secondary" href={siteConfig.contact.whatsappHref}>Über WhatsApp schreiben</a>
        </div>
      </div>
    </div>
  </section>
</MainLayout>
