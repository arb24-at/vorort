<script>
  const lab = document.querySelector<HTMLElement>(".design-lab");
  const control = document.querySelector<HTMLFieldSetElement>("#lab-mode-control");
  const selector = document.querySelector<HTMLSelectElement>("#lab-study-control");
  const canvas = document.querySelector<HTMLElement>("#lab-canvas");

  if (lab && control && selector && canvas) {
    const toggles = lab.querySelectorAll<HTMLButtonElement>("[data-panel-toggle]");
    const panels = lab.querySelectorAll<HTMLElement>(".lab-inspector");

    const showPanel = (id?: string) => {
      panels.forEach((panel) => { panel.hidden = panel.id !== id; });
      toggles.forEach((toggle) => toggle.setAttribute("aria-expanded", String(toggle.dataset.panelToggle === id)));
    };

    const updateNotes = (id: string) => {
      lab.querySelectorAll<HTMLElement>("[data-study-notes]").forEach((notes) => { notes.hidden = notes.dataset.studyNotes !== id; });
    };

    const updateMode = () => {
      const selected = control.querySelector<HTMLInputElement>("input:checked");
      if (!selected || !["general", "private", "business"].includes(selected.value)) return;
      canvas.dataset.mode = selected.value;
      lab.querySelectorAll<HTMLElement>("[data-lab-mode-label]").forEach((label) => { label.textContent = selected.value[0].toUpperCase() + selected.value.slice(1); });
    };

    const jumpToRecipe = () => {
      const target = document.getElementById(selector.value);
      if (!target) return;
      updateNotes(selector.value);
      target.scrollIntoView({ behavior: "smooth", block: "start" });
    };

    toggles.forEach((toggle) => {
      toggle.disabled = false;
      toggle.addEventListener("click", () => showPanel(toggle.getAttribute("aria-expanded") === "true" ? undefined : toggle.dataset.panelToggle));
    });

    panels.forEach((panel) => panel.addEventListener("keydown", (event) => {
      if (event.key !== "Escape") return;
      showPanel();
      lab.querySelector<HTMLButtonElement>(`[data-panel-toggle="${panel.id}"]`)?.focus();
    }));

    control.disabled = false;
    selector.disabled = false;
    selector.addEventListener("change", jumpToRecipe);
    control.addEventListener("change", updateMode);
    updateMode();

    const recipes = Array.from(canvas.querySelectorAll<HTMLElement>(".lab-experiment"));
    if ("IntersectionObserver" in window) {
      const observer = new IntersectionObserver((entries) => {
        const visible = entries.filter((entry) => entry.isIntersecting).sort((a, b) => b.intersectionRatio - a.intersectionRatio)[0];
        if (!visible) return;
        const id = (visible.target as HTMLElement).id;
        selector.value = id;
        updateNotes(id);
      }, { rootMargin: "-18% 0px -58% 0px", threshold: [0.05, 0.2, 0.5] });
      recipes.forEach((recipe) => observer.observe(recipe));
    }
  }
</script>
