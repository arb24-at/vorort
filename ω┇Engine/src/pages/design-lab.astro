---
import MainLayout from "../layouts/MainLayout.astro";
import Experiment from "../components/design-lab/Experiment.astro";
import { getServices } from "../data/services";
import "../styles/design-lab.css";

// Internal composition recipes. These are design studies, not production content or page-builder settings.
const modes = ["General", "Private", "Business"];
const recipes = [
  { id: "r01-situation", title: "R01 / Situational environment", category: "Recognition", purpose: "Turn a broad problem into a recognisable physical context.", notes: "Useful when the visitor understands their environment better than the technical category." },
  { id: "r02-dominant", title: "R02 / Dominant + supporting paths", category: "Recognition", purpose: "Give one common entry point visual priority while keeping secondary paths visible.", notes: "Use when one situation is genuinely more common or important; do not fake hierarchy." },
  { id: "r03-routing", title: "R03 / Situation → service map", category: "Service discovery", purpose: "Map customer language to service destinations without requiring self-diagnosis.", notes: "Strong candidate for audience landings where situations overlap." },
  { id: "r04-system", title: "R04 / Connected environment", category: "Connected systems", purpose: "Show how devices, access, network and storage relate spatially.", notes: "Private and business modes intentionally use different system density." },
  { id: "r05-layers", title: "R05 / Layered diagnosis", category: "Explanation", purpose: "Express a symptom as several possible layers rather than a flat checklist.", notes: "Good for computer troubleshooting, accounts and service dependencies." },
  { id: "r06-transform", title: "R06 / Before → change → outcome", category: "Sequence", purpose: "Make a controlled transformation visible without numbered cards.", notes: "Useful when the real story is a change of state rather than a list of tasks." },
  { id: "r07-process", title: "R07 / Working path", category: "Sequence", purpose: "Explain the service relationship as one continuous route.", notes: "Use for enquiry, assessment, agreement, work and handover." },
  { id: "r08-editorial", title: "R08 / Editorial split + pull quote", category: "Explanation", purpose: "Let sustained prose carry the idea while one statement provides visual emphasis.", notes: "Paragraphs are allowed to be the main design object; not everything needs UI." },
  { id: "r09-reading", title: "R09 / Long-form reading block", category: "Explanation", purpose: "Create a calm, readable passage between denser visual sections.", notes: "Use when nuance matters and compression into cards would damage meaning." },
  { id: "r10-choice", title: "R10 / Decision fork", category: "Comparison", purpose: "Compare two genuinely different routes or engagement modes.", notes: "Avoid using this for arbitrary two-column content; the contrast must be real." },
  { id: "r11-proof", title: "R11 / Evidence statement", category: "Proof", purpose: "Build trust around one factual claim and supporting evidence.", notes: "No invented ratings, counts or certification language." },
  { id: "r12-timeline", title: "R12 / Experience timeline", category: "Proof", purpose: "Use time as the organising relationship instead of a badge wall.", notes: "Best for durable history or milestones, not artificial marketing chronology." },
  { id: "r13-boundary", title: "R13 / Supported ↔ specialist boundary", category: "Boundaries", purpose: "Explain where the service ends without turning limitations into legal small print.", notes: "Paired treatment should remain calm and customer-readable." },
  { id: "r14-scope", title: "R14 / Capability constellation", category: "Scope", purpose: "Show breadth as a connected field rather than another bullet cloud.", notes: "Labels remain supporting capabilities, not extra headline services." },
  { id: "r15-annotated", title: "R15 / Annotated visual", category: "Media", purpose: "Use one visual object as the explanation surface with concise annotations.", notes: "Can later hold a real photograph, screenshot, device illustration or floor plan." },
  { id: "r16-questions", title: "R16 / Editorial Q&A cluster", category: "Questions", purpose: "Answer selected questions openly before falling back to an accordion.", notes: "Use an accordion only when the question set is long and genuinely independent." },
  { id: "r17-related", title: "R17 / Directional next paths", category: "Related services", purpose: "Make related pages feel like continuation rather than a generic card footer.", notes: "Paths can be asymmetric; relevance matters more than equal card weight." },
  { id: "r18-pause", title: "R18 / Media + narrative pause", category: "Rhythm", purpose: "Create a visual reset between information-heavy sections.", notes: "A photograph, illustration, statement or quiet paragraph can carry this role." }
 ];

const openingStudies = [
  { id: "p01-business-opening", title: "P01 / Business opening — dark to light", category: "Audience opening", purpose: "Test a business-service opening where a dark architectural hero resolves into a light planning section.", notes: "Live content from office-network/en.yml. Difference comes from density, grid logic and infrastructure mapping — not a separate brand colour." },
  { id: "p02-private-opening", title: "P02 / Private opening — light to dark", category: "Audience opening", purpose: "Test a private-service opening where a light environmental hero resolves into a darker spatial explanation.", notes: "Live content from wifi-home-network/en.yml. Difference comes from recognisable rooms, objects, softer geometry and lower information density." }
];
const studies = [...openingStudies, ...recipes];

const businessServices = await getServices("business", "en");
const privateServices = await getServices("private", "en");
const officeNetwork = businessServices.find((service) => service.translationId === "network-it-support");
const homeNetwork = privateServices.find((service) => service.translationId === "wifi-home-network");

if (!officeNetwork || !homeNetwork) {
  throw new Error("Design Lab opening studies require the English office-network and wifi-home-network service records.");
}

const officeHeroPanel = officeNetwork.page.storyboard?.[0];
const officeFirstPanel = officeNetwork.page.storyboard?.[1];
const homeHeroPanel = homeNetwork.page.storyboard?.[0];
const homeFirstPanel = homeNetwork.page.storyboard?.[1];

if (!officeHeroPanel || !officeFirstPanel || !homeHeroPanel || !homeFirstPanel) {
  throw new Error("Design Lab opening studies require the first two storyboard panels for both reference services.");
}
---

<MainLayout
  title="Internal Design Lab"
  description="Internal composition recipe catalogue and foundation reference."
  canonicalPath="design-lab/"
  robots="noindex, nofollow"
  lang="en"
  showSiteChrome={false}
>
  <div class="design-lab">
    <header class="lab-toolbar">
      <div class="container lab-controls">
        <div class="lab-identity">
          <p class="lab-label">Internal · Recipe catalogue</p>
          <h1>Design Lab</h1>
        </div>

        <fieldset id="lab-mode-control" disabled>
          <legend>Canvas mode</legend>
          <div class="lab-modes">
            {modes.map((mode) => (
              <label>
                <input type="radio" name="lab-mode" value={mode.toLowerCase()} checked={mode === "General"} aria-controls="lab-canvas" />
                <span>{mode}</span>
              </label>
            ))}
          </div>
        </fieldset>

        <label class="lab-study-control">
          <span>Jump to study</span>
          <select id="lab-study-control" aria-controls="lab-canvas lab-notes" disabled>
            {studies.map((study) => <option value={study.id}>{study.title}</option>)}
          </select>
        </label>

        <div class="lab-panel-controls">
          <button type="button" data-panel-toggle="lab-notes" aria-controls="lab-notes" aria-expanded="false" disabled>Notes</button>
          <button type="button" data-panel-toggle="lab-foundation" aria-controls="lab-foundation" aria-expanded="false" disabled>Foundation</button>
        </div>
      </div>
    </header>

    <noscript><p class="container lab-noscript">JavaScript is off. All studies remain readable; mode switching, study jumping and inspectors require JavaScript.</p></noscript>

    <aside id="lab-notes" class="lab-inspector container" aria-label="Selected recipe notes" hidden tabindex="-1">
      {studies.map((study, index) => (
        <div class="lab-notes" data-study-notes={study.id} hidden={index !== 0}>
          <p class="lab-kicker">{study.category}</p>
          <h2>{study.title}</h2>
          <dl>
            <div><dt>Purpose</dt><dd>{study.purpose}</dd></div>
            <div><dt>Status</dt><dd>Study · exploratory</dd></div>
            <div><dt>Mode</dt><dd data-lab-mode-label>General</dd></div>
            <div><dt>Notes</dt><dd>{study.notes}</dd></div>
          </dl>
        </div>
      ))}
      <p class="lab-reference-note">Opening studies test page-family language; recipes express reusable information relationships. Neither creates layout settings in YAML.</p>
    </aside>

    <section class="lab-inspector container" id="lab-foundation" aria-labelledby="lab-foundation-title" hidden tabindex="-1">
      <h2 id="lab-foundation-title" class="lab-panel-title">Foundation reference</h2>
      <div class="lab-foundation-body">
        <p class="lab-label">Inherited shared styles · unaffected by recipe choice</p>
        <div class="lab-reference-grid">
          <div lang="de">
            <p class="lab-label">H1 / current service hero</p>
            <div class="service-hero service-hero--story lab-type-sample"><div class="service-hero__copy"><h1>Technik im Alltag</h1></div></div>
            <p class="lab-label">H2 / section-title</p>
            <h2 class="section-title">Zusammenhänge verstehen</h2>
            <p class="lab-label">Body heading</p>
            <h3>Ein Arbeitsplatz, mehrere Verbindungen</h3>
            <p class="eyebrow">Orientierung vor Ort</p>
            <p>Ein Computer, ein Zugang und eine Verbindung gehören im Alltag zusammen. Ein kurzer Überblick hilft, den nächsten Schritt zu besprechen.</p>
          </div>
          <div>
            <div class="lab-surfaces">
              <div class="lab-surface lab-surface--light"><code>--paper-light</code><p>Light page surface</p></div>
              <div class="lab-surface lab-surface--paper"><code>--paper</code><p>Soft section surface</p></div>
              <div class="lab-surface lab-surface--white"><code>--surface</code><p>Raised surface</p></div>
              <div class="lab-surface lab-surface--dark"><code>--night</code><p>Dark technical surface</p></div>
            </div>
            <p class="lab-label">Existing border / radius tokens</p>
            <div class="lab-radii">
              <span style="border-radius: var(--radius-sm)">sm</span><span style="border-radius: var(--radius-md)">md</span><span style="border-radius: var(--radius-lg)">lg</span><span style="border-radius: var(--radius-xl)">xl</span>
            </div>
          </div>
        </div>
      </div>
    </section>

    <div class="lab-intro container">
      <div>
        <p class="eyebrow">Composition, not component count</p>
        <h2 class="section-title">One content relationship, many possible forms.</h2>
      </div>
      <p>Use this canvas to judge how sections behave together. Lists, cards and accordions remain valid tools, but they should not become the default representation for every kind of information.</p>
    </div>

    <main id="lab-canvas" class="lab-canvas" data-mode="general" tabindex="-1" aria-label="Composition recipe canvas">
      <section id={openingStudies[0].id} class="lab-experiment lab-opening-study" aria-label={openingStudies[0].title}>
        <div class="lab-recipe-meta container">
          <div><span>{openingStudies[0].category}</span><h2>{openingStudies[0].title}</h2></div>
          <p>{openingStudies[0].purpose}</p>
        </div>
        <div class="opening-prototype opening-prototype--business">
          <section class="opening-hero opening-hero--business">
            <div class="container opening-business-grid">
              <div class="opening-copy opening-copy--business">
                <span class="opening-back">← All business services</span>
                <p class="opening-eyebrow">{officeNetwork.hero.eyebrow}</p>
                <h2 class="opening-hero-title">{officeNetwork.hero.title}</h2>
                <p class="opening-hero-intro">{officeNetwork.hero.intro}</p>
                <div class="btn-row opening-actions" aria-hidden="true">
                  <span class="btn btn-primary">Request support</span>
                  <span class="btn btn-ghost">WhatsApp</span>
                </div>
              </div>
              <figure class="business-plan" aria-label="Office infrastructure plan showing rooms, workspaces and shared network infrastructure">
                <figcaption><span>Infrastructure view</span><strong>{officeHeroPanel.title}</strong></figcaption>
                <svg viewBox="0 0 760 500" role="img" aria-label="Simplified office plan connected to one infrastructure core">
                  <rect class="plan-shell" x="35" y="70" width="690" height="365" rx="8" />
                  <rect class="plan-zone" x="70" y="110" width="260" height="120" rx="4" />
                  <rect class="plan-zone" x="370" y="110" width="310" height="120" rx="4" />
                  <rect class="plan-zone" x="70" y="270" width="215" height="120" rx="4" />
                  <rect class="plan-zone" x="325" y="270" width="355" height="120" rx="4" />
                  <path class="plan-route" d="M200 230 V250 H500 V270 M480 230 V250 M180 270 V250" />
                  <circle class="plan-core" cx="500" cy="250" r="31" />
                  <circle class="plan-point" cx="200" cy="170" r="9" />
                  <circle class="plan-point" cx="480" cy="170" r="9" />
                  <circle class="plan-point" cx="180" cy="330" r="9" />
                  <circle class="plan-point" cx="510" cy="330" r="9" />
                  <text x="92" y="143">WORKSPACES</text><text x="392" y="143">MEETING / SHARED</text><text x="92" y="303">CABLING</text><text x="347" y="303">STORAGE / SERVICES</text>
                  <text class="plan-core-label" x="500" y="255" text-anchor="middle">CORE</text>
                </svg>
                <div class="plan-callouts" aria-hidden="true">
                  {officeHeroPanel.callouts.map((callout) => <span>{callout}</span>)}
                </div>
              </figure>
            </div>
          </section>

          <section class="opening-first opening-first--business">
            <div class="container opening-business-first-grid">
              <div class="opening-first-copy">
                <p class="opening-eyebrow opening-eyebrow--signal">{officeFirstPanel.eyebrow}</p>
                <h2 class="opening-section-title">{officeFirstPanel.title}</h2>
                <p>{officeFirstPanel.text}</p>
              </div>
              <div class="business-requirements" aria-label="Planning requirements organised around one office">
                <div class="business-requirements__core"><span>Start here</span><strong>How the office is actually used</strong></div>
                {officeFirstPanel.callouts.map((callout, index) => (
                  <article class={`requirement requirement--${index + 1}`}>
                    <span>0{index + 1}</span><strong>{callout}</strong><p>{officeFirstPanel.points[index]}</p>
                  </article>
                ))}
              </div>
            </div>
          </section>
        </div>
      </section>

      <section id={openingStudies[1].id} class="lab-experiment lab-opening-study" aria-label={openingStudies[1].title}>
        <div class="lab-recipe-meta container">
          <div><span>{openingStudies[1].category}</span><h2>{openingStudies[1].title}</h2></div>
          <p>{openingStudies[1].purpose}</p>
        </div>
        <div class="opening-prototype opening-prototype--private">
          <section class="opening-hero opening-hero--private">
            <div class="container opening-private-grid">
              <div class="opening-copy opening-copy--private">
                <span class="opening-back">← All home services</span>
                <p class="opening-eyebrow opening-eyebrow--signal">{homeNetwork.hero.eyebrow}</p>
                <h2 class="opening-hero-title">{homeNetwork.hero.title}</h2>
                <p class="opening-hero-intro">{homeNetwork.hero.intro}</p>
                <div class="btn-row opening-actions" aria-hidden="true">
                  <span class="btn btn-primary">Request support</span>
                  <span class="btn btn-ghost">WhatsApp</span>
                </div>
              </div>
              <figure class="home-scene" aria-label="Home network shown as rooms, everyday devices, Wi-Fi and shared storage">
                <figcaption><span>Home context</span><strong>{homeHeroPanel.title}</strong></figcaption>
                <div class="home-scene__house" aria-hidden="true">
                  <div class="home-room home-room--office"><span>Home office</span><i class="home-device home-device--laptop"></i></div>
                  <div class="home-room home-room--living"><span>Living</span><i class="home-device home-device--tv"></i></div>
                  <div class="home-room home-room--storage"><span>Shared storage</span><i class="home-device home-device--nas"></i></div>
                  <div class="home-router-dot"><b>Wi-Fi</b></div>
                  <i class="wifi-arc wifi-arc--one"></i><i class="wifi-arc wifi-arc--two"></i><i class="wifi-arc wifi-arc--three"></i>
                  <i class="home-cable home-cable--one"></i><i class="home-cable home-cable--two"></i>
                </div>
                <div class="home-scene__callouts">{homeHeroPanel.callouts.map((callout) => <span>{callout}</span>)}</div>
              </figure>
            </div>
          </section>

          <section class="opening-first opening-first--private">
            <div class="container opening-private-first-grid">
              <div class="opening-first-copy">
                <p class="opening-eyebrow opening-eyebrow--mint">{homeFirstPanel.eyebrow}</p>
                <h2 class="opening-section-title">{homeFirstPanel.title}</h2>
                <p>{homeFirstPanel.text}</p>
              </div>
              <div class="private-room-map" aria-label="Home layout showing wireless path, cable route, storage and home-office needs">
                <div class="private-room-map__shell" aria-hidden="true">
                  <div class="private-map-room r1">Home office</div><div class="private-map-room r2">Living</div><div class="private-map-room r3">Hall</div><div class="private-map-room r4">Storage</div>
                  <div class="private-map-router">Wi-Fi</div><div class="private-map-nas">NAS</div>
                  <svg viewBox="0 0 720 420"><path class="private-map-wireless" d="M370 205 C250 80 150 90 95 150 M370 205 C500 80 620 115 655 180"/><path class="private-map-cable" d="M370 205 L370 315 L560 315" /></svg>
                </div>
                <div class="private-map-labels">{homeFirstPanel.callouts.map((callout) => <span>{callout}</span>)}</div>
              </div>
            </div>
          </section>
        </div>
      </section>

      <div class="lab-catalogue-divider container">
        <p class="lab-kicker">Reusable composition vocabulary</p>
        <h2>Recipe catalogue</h2>
        <p>The opening studies above test page-family language. The recipes below remain independent tools for the rest of a page.</p>
      </div>

      <Experiment recipe={recipes[0]} surface="warm">
        <div class="recipe-situation">
          <div class="recipe-copy">
            <p class="eyebrow">Zuhause & Homeoffice</p>
            <h2 class="section-title">Sie beschreiben, was Sie bemerken.</h2>
            <p class="section-lead">Computer, Software und Heimnetz hängen im Alltag zusammen. Der Einstieg beginnt bei Ihrer Situation – nicht bei einer technischen Diagnose.</p>
          </div>
          <div class="environment-stage" aria-label="Vereinfachte Umgebung mit verbundenen Geräten und Diensten">
            <div class="environment-desk" aria-hidden="true"></div>
            <div class="environment-screen" aria-hidden="true"><span></span></div>
            <div class="environment-router" aria-hidden="true"></div>
            <div class="environment-node node-a"><strong data-mode-general>Gerät</strong><strong data-mode-private>Computer</strong><strong data-mode-business>Arbeitsplatz</strong><span>startet nicht</span></div>
            <div class="environment-node node-b"><strong data-mode-general>Verbindung</strong><strong data-mode-private>WLAN</strong><strong data-mode-business>Netzwerk</strong><span>ist instabil</span></div>
            <div class="environment-node node-c"><strong data-mode-general>Zugang</strong><strong data-mode-private>E-Mail</strong><strong data-mode-business>Cloud</strong><span>fehlt</span></div>
            <div class="environment-node node-d"><strong data-mode-general>Änderung</strong><strong data-mode-private>Neues Gerät</strong><strong data-mode-business>Neue Arbeitsplätze</strong><span>steht an</span></div>
          </div>
        </div>
      </Experiment>

      <Experiment recipe={recipes[1]}>
        <div class="recipe-dominant">
          <article class="dominant-path">
            <p class="eyebrow">Der häufigste Einstieg</p>
            <h2 class="section-title">Der Computer verhält sich plötzlich anders.</h2>
            <p>Langsam, instabil, nach einem Update oder mit einer Anmeldung, die nicht mehr funktioniert. Das sichtbare Symptom bekommt zuerst Raum.</p>
            <a href="#r03-routing">Situation einordnen →</a>
          </article>
          <div class="supporting-paths">
            <article><span>01</span><h3>Software macht Schwierigkeiten</h3><p>Installieren, aktualisieren, konfigurieren oder Konflikte lösen.</p></article>
            <article><span>02</span><h3>WLAN und Geräte gehören zusammen</h3><p>Verbindung, NAS, Drucker und Homeoffice als eine Umgebung betrachten.</p></article>
            <article><span>03</span><h3>Ein Gerätewechsel steht an</h3><p>Auswahl, Einrichtung, Daten, E-Mail und Backup als einen Weg planen.</p></article>
          </div>
        </div>
      </Experiment>

      <Experiment recipe={recipes[2]} surface="soft">
        <div class="routing-head">
          <div><p class="eyebrow">Sie müssen die Ursache nicht kennen</p><h2 class="section-title">Von der Situation zum passenden Leistungsbereich.</h2></div>
          <p>Die Pfeile zeigen Orientierung, keine harte Diagnose. Überschneidungen bleiben erlaubt.</p>
        </div>
        <div class="routing-map" aria-label="Beispiele für Situationen und mögliche Leistungsbereiche">
          <div class="routing-situations">
            <div><span class="route-dot route-dot--alert">!</span><p>Mein Computer ist langsam oder startet nicht.</p></div>
            <div><span class="route-dot">↻</span><p>Ein Programm funktioniert nicht oder lässt sich nicht installieren.</p></div>
            <div><span class="route-dot route-dot--mint">⌁</span><p>WLAN, NAS oder Drucker arbeiten nicht sinnvoll zusammen.</p></div>
            <div><span class="route-dot route-dot--blue">▣</span><p>Ich richte ein neues Gerät ein und möchte meine Daten übernehmen.</p></div>
            <div><span class="route-dot route-dot--neutral">?</span><p>Ich bin nicht sicher, wo die Ursache liegt.</p></div>
          </div>
          <div class="routing-lines" aria-hidden="true"><i></i><i></i><i></i><i></i><i></i></div>
          <div class="routing-services">
            <div><strong>Computer- & Laptop-Hilfe</strong><span>System, Start, Zugriff</span></div>
            <div><strong>Software & Optimierung</strong><span>Programme, Updates, Konflikte</span></div>
            <div><strong>WLAN & Heimnetz</strong><span>Verbindung, Geräte, Speicher</span></div>
            <div><strong>Einrichtung & Datenumzug</strong><span>Neues Gerät, Übernahme, Backup</span></div>
            <div class="routing-open"><strong>Gemeinsam einordnen</strong><span>Problem schildern, ohne Servicewahl</span></div>
          </div>
        </div>
      </Experiment>

      <Experiment recipe={recipes[3]} surface="dark">
        <div class="system-head"><p class="eyebrow eyebrow--dark">Zusammenhänge sichtbar machen</p><h2 class="section-title">Nicht fünf Punkte. Ein System.</h2></div>
        <div class="system-modes">
          <div data-mode-panel="general" class="system-topology">
            <span class="system-node system-node--core">Aufgabe</span><span class="system-node n1">Gerät</span><span class="system-node n2">Verbindung</span><span class="system-node n3">Zugang</span><span class="system-node n4">Daten</span>
          </div>
          <div data-mode-panel="private" class="system-topology system-topology--private">
            <span class="system-node system-node--core">Homeoffice</span><span class="system-node n1">Laptop</span><span class="system-node n2">WLAN</span><span class="system-node n3">Drucker</span><span class="system-node n4">NAS</span><span class="system-node n5">E-Mail</span>
          </div>
          <div data-mode-panel="business" class="system-topology system-topology--business">
            <span class="system-node system-node--core">Arbeitsplatz</span><span class="system-node n1">Endpoint</span><span class="system-node n2">Switch</span><span class="system-node n3">Wi-Fi</span><span class="system-node n4">Cloud</span><span class="system-node n5">Storage</span><span class="system-node n6">Identity</span>
          </div>
        </div>
      </Experiment>

      <Experiment recipe={recipes[4]}>
        <div class="layered-diagnosis">
          <div class="layer-copy"><p class="eyebrow">Vom Symptom zur Ebene</p><h2 class="section-title">„Langsam“ ist eine Beobachtung, keine Diagnose.</h2><p>Statt mehrere mögliche Ursachen als Liste nebeneinanderzustellen, kann die Darstellung zeigen, welche Schichten nacheinander geprüft werden.</p></div>
          <div class="layer-stack" aria-label="Vier Diagnoseebenen">
            <div><span>01</span><strong>Gerät</strong><small>Start, Speicher, Stabilität</small></div>
            <div><span>02</span><strong>System</strong><small>Windows oder macOS</small></div>
            <div><span>03</span><strong>Software</strong><small>Programme, Updates, Profile</small></div>
            <div><span>04</span><strong>Verbindung</strong><small>Netzwerk, Zugang, Cloud</small></div>
          </div>
        </div>
      </Experiment>

      <Experiment recipe={recipes[5]} surface="soft">
        <div class="transform-head"><p class="eyebrow">Kontrollierte Veränderung</p><h2 class="section-title">Ein Zustand verändert sich sichtbar.</h2></div>
        <div class="transform-flow">
          <figure><div class="state state--before"><span></span><strong>Vorher</strong><p>Unklarer Zustand, mehrere mögliche Ursachen.</p></div></figure>
          <div class="transform-arrow" aria-hidden="true">→</div>
