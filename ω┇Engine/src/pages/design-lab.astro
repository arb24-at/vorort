---
import MainLayout from "../layouts/MainLayout.astro";
import Experiment from "../components/design-lab/Experiment.astro";
import "../styles/design-lab.css";

// Deliberate Lab fixtures, not service content or approved production compositions.
const modes = ["General", "Private", "Business"];
const studies = [
  {
    "id": "lab-split",
    "title": "01 / Text + visual split",
    "purpose": "Balance a short explanation with a visual area.",
    "notes": "Two columns at desktop; text first when stacked."
  },
  {
    "id": "lab-editorial",
    "title": "02 / Editorial wide + narrow",
    "purpose": "Judge sustained reading beside a brief annotation.",
    "notes": "Longer text fixture; narrow column becomes a closing note."
  },
  {
    "id": "lab-technical",
    "title": "03 / Dark technical field",
    "purpose": "Test contrast and the relationship between text and a sequence.",
    "notes": "Existing dark surface; neutral diagram, no service-state claim."
  },
  {
    "id": "lab-transition",
    "title": "04 / Full-width transition",
    "purpose": "Create a pause between two denser sections.",
    "notes": "One statement across the content width; no card wrapper."
  },
  {
    "id": "lab-asymmetric",
    "title": "05 / Asymmetric two-column section",
    "purpose": "Compare a compact introduction with more detailed reading.",
    "notes": "Short left column, wider right column; natural reading order on mobile."
  }
];
---

<MainLayout
  title="Internal Design Lab"
  description="Internal composition experiments and existing foundation reference."
  canonicalPath="design-lab/"
  robots="noindex, nofollow"
  lang="en"
  showSiteChrome={false}
>
  <div class="design-lab">
    <header class="lab-toolbar">
      <div class="container lab-controls">
        <div class="lab-identity">
          <p class="lab-label">Internal · Phase 1.1</p>
          <h1>Design Lab</h1>
        </div>
        <fieldset id="lab-mode-control" disabled>
          <legend>Canvas mode</legend>
          <div class="lab-modes">
            {modes.map((mode) => (
              <label>
                <input type="radio" name="lab-mode" value={mode.toLowerCase()} checked={mode === "General"} aria-controls="lab-canvas" />
                <span>{mode}</span>
              </label>
            ))}
          </div>
        </fieldset>
        <label class="lab-study-control">
          <span>Study</span>
          <select id="lab-study-control" aria-controls="lab-canvas lab-notes" disabled>
            {studies.map((study) => <option value={study.id}>{study.title}</option>)}
          </select>
        </label>
        <div class="lab-panel-controls">
          <button type="button" data-panel-toggle="lab-notes" aria-controls="lab-notes" aria-expanded="false" disabled>Notes</button>
          <button type="button" data-panel-toggle="lab-foundation" aria-controls="lab-foundation" aria-expanded="false" disabled>Foundation</button>
        </div>
      </div>
    </header>
    <noscript><p class="container">JavaScript is off. The first study remains readable; enable JavaScript to switch studies or open the inspectors.</p></noscript>

    <aside id="lab-notes" class="lab-inspector container" aria-label="Selected study notes" hidden tabindex="-1">
      {studies.map((study, index) => (
        <div class="lab-notes" data-study-notes={study.id} hidden={index !== 0}>
          <h2 class="lab-label">{study.title}</h2>
          <dl>
            <div><dt>Purpose</dt><dd>{study.purpose}</dd></div>
            <div><dt>Status</dt><dd>Shell · unapproved</dd></div>
            <div><dt>Mode</dt><dd data-lab-mode-label>General</dd></div>
            <div><dt>Notes</dt><dd>{study.notes}</dd></div>
          </dl>
        </div>
      ))}
      <p class="lab-reference-note">Mode changes only the canvas marker in this phase. All sample copy and composition shells are unapproved.</p>
      <p class="lab-reference-note">Add future experiments only after a focused design brief. These shells establish no approved private, business or production pattern.</p>
    </aside>

    <section class="lab-inspector container" id="lab-foundation" aria-labelledby="lab-foundation-title" hidden tabindex="-1">
      <h2 id="lab-foundation-title" class="lab-panel-title">Foundation reference</h2>
      <div class="lab-foundation-body">
        <p class="lab-label">Reference only · inherited shared styles · unaffected by canvas mode</p>
        <div class="lab-reference-grid">
          <div lang="de">
            <p class="lab-label">H1 / current service hero</p>
            <div class="service-hero service-hero--story lab-type-sample">
              <div class="service-hero__copy"><h1>Technik im Alltag</h1></div>
            </div>
            <p class="lab-label">H2 / section-title</p>
            <h2 class="section-title">Zusammenhänge verstehen</h2>
            <p class="lab-label">H3 / body heading</p>
            <h3>Ein Arbeitsplatz, mehrere Verbindungen</h3>
            <p class="eyebrow">Orientierung vor Ort</p>
            <p>Ein Computer, ein Zugang und eine Verbindung gehören im Alltag zusammen. Ein kurzer Überblick hilft, den nächsten Schritt zu besprechen.</p>
            <div class="btn-row">
              <button type="button" class="btn btn-primary" data-lab-show-stage>Komposition ansehen</button>
              <button type="button" class="btn btn-secondary" data-lab-show-notes>Lab-Notizen lesen</button>
            </div>
          </div>
          <div>
            <div class="lab-surfaces">
              <div class="lab-surface lab-surface--light"><code>--paper-light</code><p>Light page surface</p></div>
              <div class="lab-surface lab-surface--paper"><code>--paper</code><p>Soft section surface</p></div>
              <div class="lab-surface lab-surface--white"><code>--surface</code><p>Raised surface</p></div>
              <div class="lab-surface lab-surface--dark"><code>--night</code><p>Dark technical surface</p></div>
            </div>
            <p class="lab-label">Existing border / radius tokens</p>
            <div class="lab-radii">
              <span style="border-radius: var(--radius-sm)">sm</span>
              <span style="border-radius: var(--radius-md)">md</span>
              <span style="border-radius: var(--radius-lg)">lg</span>
              <span style="border-radius: var(--radius-xl)">xl</span>
            </div>
            <p class="lab-label">Rhythm / real .section padding</p>
            <div class="section lab-spacing"><span>Content edge</span></div>
            <p class="lab-reference-note">Uses the shared responsive section rule and <code>--section-pad</code>. The surrounding frame marks its padding.</p>
          </div>
        </div>
      </div>
    </section>

    <div id="lab-canvas" class="lab-canvas" data-mode="general" tabindex="-1" aria-label="Composition canvas">
      <Experiment study={studies[0]} selected>
        <div class="lab-split">
          <div>
            <p class="eyebrow">Ein erster Überblick</p>
            <h2 class="section-title">Was hängt miteinander zusammen?</h2>
            <p class="section-lead">Am Arbeitsplatz treffen Gerät, Programme und Verbindung aufeinander. Wir schauen gemeinsam auf die Situation.</p>
          </div>
          <figure class="lab-visual">
            <div class="lab-diagram" aria-label="Beispiel: Gerät ist über eine Verbindung mit einem Zugang verbunden.">
              <span>Gerät</span><i aria-hidden="true">↔</i><span>Verbindung</span><i aria-hidden="true">↔</i><span>Zugang</span>
            </div>
            <figcaption>Platz für eine spätere Darstellung der Zusammenhänge.</figcaption>
          </figure>
        </div>
      </Experiment>

      <Experiment study={studies[1]}>
        <div class="lab-editorial">
          <div>
            <p class="eyebrow">Die Situation beschreiben</p>
            <h2 class="section-title">Erst verstehen, dann den nächsten Schritt planen.</h2>
            <p>Manchmal betrifft eine Veränderung mehr als ein einzelnes Gerät. Ein Programm verhält sich anders, eine Verbindung fehlt oder ein Zugang wird neu benötigt.</p>
            <p>Hilfreich ist zunächst ein Blick auf den Alltag: Was möchten Sie erledigen, was funktioniert bereits und an welcher Stelle kommen Sie nicht weiter?</p>
          </div>
          <aside class="lab-margin-note"><h3>Ein konkretes Beispiel</h3><p>Eine Datei lässt sich am Computer öffnen, ist aber am zweiten Arbeitsplatz nicht erreichbar.</p></aside>
        </div>
      </Experiment>

      <Experiment study={studies[2]} surface="dark">
        <div class="lab-split">
          <div><p class="eyebrow eyebrow--dark">Die Verbindung betrachten</p><h2 class="section-title">Ein Weg durch das System.</h2><p class="section-lead">Vom Gerät über die Verbindung bis zum Zugang: Einzelne Schritte machen den Zusammenhang sichtbar.</p></div>
          <ol class="lab-sequence"><li><span>01</span>Gerät betrachten</li><li><span>02</span>Verbindung nachvollziehen</li><li><span>03</span>Zugang einordnen</li></ol>
        </div>
      </Experiment>

      <Experiment study={studies[3]} surface="soft">
        <p class="eyebrow">Raum für den nächsten Schritt</p>
        <h2 class="section-title">Aus einzelnen Beobachtungen entsteht ein gemeinsamer Überblick.</h2>
      </Experiment>

      <Experiment study={studies[4]}>
        <div class="lab-asymmetric">
          <div><p class="eyebrow">Gemeinsam einordnen</p><h2 class="section-title">Was soll sich verändern?</h2></div>
          <div class="lab-detail-copy"><h3>Der Alltag gibt die Richtung vor.</h3><p>Ein neuer Arbeitsplatz, ein Gerätewechsel oder ein veränderter Ablauf: Entscheidend ist, welche Aufgaben Sie damit erledigen möchten.</p><p>Aus dieser Beschreibung lässt sich besprechen, welche Verbindungen und Einstellungen genauer betrachtet werden sollten.</p></div>
        </div>
      </Experiment>
    </div>

  </div>
</MainLayout>

<script>
  const lab = document.querySelector<HTMLElement>(".design-lab");
  const control = document.querySelector<HTMLFieldSetElement>("#lab-mode-control");
  const selector = document.querySelector<HTMLSelectElement>("#lab-study-control");
  const canvas = document.querySelector<HTMLElement>("#lab-canvas");

  if (lab && control && selector && canvas) {
    const toggles = lab.querySelectorAll<HTMLButtonElement>("[data-panel-toggle]");
    const panels = lab.querySelectorAll<HTMLElement>(".lab-inspector");
    const showPanel = (id?: string) => {
      panels.forEach((panel) => { panel.hidden = panel.id !== id; });
      toggles.forEach((toggle) => {
        toggle.setAttribute("aria-expanded", String(toggle.dataset.panelToggle === id));
      });
    };
    const updateStudy = () => {
      canvas.querySelectorAll<HTMLElement>(".lab-experiment").forEach((study) => {
        study.hidden = study.id !== selector.value;
      });
      lab.querySelectorAll<HTMLElement>("[data-study-notes]").forEach((notes) => {
        notes.hidden = notes.dataset.studyNotes !== selector.value;
      });
    };
    const updateMode = () => {
      const selected = control.querySelector<HTMLInputElement>("input:checked");
      if (!selected || !["general", "private", "business"].includes(selected.value)) return;
      canvas.dataset.mode = selected.value;
      lab.querySelectorAll<HTMLElement>("[data-lab-mode-label]").forEach((label) => {
        label.textContent = selected.value[0].toUpperCase() + selected.value.slice(1);
      });
    };
    toggles.forEach((toggle) => {
      toggle.disabled = false;
      toggle.addEventListener("click", () => {
        showPanel(toggle.getAttribute("aria-expanded") === "true" ? undefined : toggle.dataset.panelToggle);
      });
    });
    panels.forEach((panel) => panel.addEventListener("keydown", (event) => {
      if (event.key !== "Escape") return;
      showPanel();
      lab.querySelector<HTMLButtonElement>(`[data-panel-toggle="${panel.id}"]`)?.focus();
    }));
    lab.querySelector("[data-lab-show-stage]")?.addEventListener("click", () => {
      showPanel();
      canvas.focus();
    });
    lab.querySelector("[data-lab-show-notes]")?.addEventListener("click", () => {
      showPanel("lab-notes");
      document.querySelector<HTMLElement>("#lab-notes")?.focus();
    });
    control.disabled = false;
    selector.disabled = false;
    selector.addEventListener("change", updateStudy);
    control.addEventListener("change", updateMode);
    updateStudy();
    updateMode();
  }
</script>
