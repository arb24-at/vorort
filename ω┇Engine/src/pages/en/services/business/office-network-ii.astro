---
import MainLayout from "../../../../layouts/MainLayout.astro";
import ServiceConceptII from "../../../../components/ServiceConceptII.astro";

const canonicalPath = "/en/services/business/office-network-ii/";

const scopeItems = [
  { title: "Office Wi‑Fi & work areas", artKind: "office-wifi" },
  { title: "Cabling, outlets & routes", artKind: "office-cabling" },
  { title: "Managed network hardware", artKind: "network-core" },
  { title: "Shared storage & services", artKind: "storage-business" },
  { title: "Secure access & connectivity", artKind: "secure-access" }
] as const;

const galleryItems = [
  {
    eyebrow: "Planning",
    title: "Start with the workplace, not with a shopping list",
    body: "Rooms, workspaces, users, cable routes, Wi‑Fi requirements and likely growth define what the infrastructure needs to support before hardware is selected.",
    artKind: "office-wifi"
  },
  {
    eyebrow: "Physical infrastructure",
    title: "Make cabling and equipment understandable",
    body: "Network outlets, patching, cabinets and managed hardware should form a traceable system rather than a collection of unrelated devices accumulated over time.",
    artKind: "office-cabling"
  },
  {
    eyebrow: "Shared services",
    title: "Connect storage and access to the way people actually work",
    body: "NAS, internal resources, staff or guest access and secure remote connectivity can be integrated where they belong in the agreed network scope.",
    artKind: "storage-business"
  }
] as const;

const situations = [
  {
    title: "A new office needs infrastructure before the team moves in",
    body: "Planning early makes it easier to place outlets, cable routes, Wi‑Fi access points and shared equipment around the actual workspace."
  },
  {
    title: "The business has added rooms, desks or people",
    body: "An older network may still function but no longer fit the way the workplace is being used or the number of services depending on it."
  },
  {
    title: "The network works, but nobody really understands it",
    body: "Improvised switches, undocumented patching and mixed generations of equipment make future changes harder and troubleshooting slower."
  },
  {
    title: "A planned modernisation is better than another temporary fix",
    body: "A clean rebuild can make physical infrastructure, Wi‑Fi, shared storage and secure access easier to support and extend."
  }
];

const steps = [
  { title: "Survey the premises", body: "Rooms, work areas, existing connections, cable routes and current infrastructure establish the physical starting point." },
  { title: "Define the requirements", body: "Users, Wi‑Fi, shared equipment, storage, internal resources, access and future changes shape the network design." },
  { title: "Implement the agreed scope", body: "Cabling, cabinets, managed hardware, business Wi‑Fi, NAS and secure connectivity are installed and configured as required." },
  { title: "Test, document and hand over", body: "The network should be understandable after the project, with testing and a practical handover rather than unexplained infrastructure." }
];

const faqs = [
  { question: "Do you work on both new offices and existing networks?", answer: "Yes. The service can cover new-office planning, expansion, modernisation and problem-led work on an existing small-business network." },
  { question: "Can you supply the network hardware as well?", answer: "Equipment recommendations and optional procurement can be part of an agreed project. The exact hardware depends on the premises, requirements and supportability." },
  { question: "Can you install cabling, outlets and network cabinets?", answer: "Yes, within the agreed project scope and the practical constraints of the premises. Cable routes and installation details are assessed rather than assumed." },
  { question: "Can secure remote access or VPN be included?", answer: "Appropriate secure remote access can be part of a network project. This does not turn the service into an enterprise cybersecurity or penetration-testing consultancy." },
  { question: "Do we need an ongoing maintenance contract?", answer: "No. One-off projects, planned infrastructure work and problem resolution are primary. Occasional or recurring support can be discussed where it is useful, but it is not a standard requirement." }
];
---

<MainLayout
  title="Network Infrastructure & Cabling Berlin — Concept II"
  description="Experimental noindex design concept for office network infrastructure, cabling, business Wi-Fi and shared services in Berlin."
  canonicalPath={canonicalPath}
  lang="en"
  robots="noindex, nofollow"
>
  <ServiceConceptII
    mode="business"
    eyebrow="Business · Network infrastructure"
    title="Network infrastructure for businesses in Berlin"
    intro="We plan, supply, install and configure network infrastructure for small and growing businesses in Berlin — from cabling and business Wi‑Fi to managed network hardware, shared storage and secure access."
    heroArtLabel="Tactile illustrated small-business workplace scene: desks, meeting area, cable routes, access points, network cabinet and shared services in one structured architectural composition."
    scopeHeading="The infrastructure areas this service can bring together"
    scopeIntro="The page should make the project scope visible immediately, before asking a business owner or office manager to read technical detail."
    scopeItems={scopeItems}
    galleryEyebrow="Workplace infrastructure"
    galleryHeading="Build the network around how the office actually operates"
    galleryIntro="Business pages use the same art family as Private, but with stricter geometry, larger spatial scale and more system relationships. The final panels should feel architectural, not like software dashboards."
    galleryItems={galleryItems}
    situationsEyebrow="Common project triggers"
    situationsHeading="When an office network deserves planned attention"
    situationsIntro="The visitor normally knows there is a project. This section helps frame the type of change without reducing the page to a hardware specification."
    situations={situations}
    processEyebrow="Planning and delivery"
    processHeading="From premises and requirements to working infrastructure"
    processIntro="This is where the page earns technical credibility: a clear method tied to real rooms, users, equipment and operational needs rather than generic IT consulting language."
    steps={steps}
    outcomeEyebrow="Useful outcome"
    outcomeHeading="Not a pile of devices. Infrastructure the business can understand and extend."
    outcomeBody="The target is organised, traceable connectivity that works where it is needed, supports agreed shared resources and leaves a clearer foundation for future changes."
    included={["Office network planning", "Ethernet cabling", "Network outlets and patching", "Network cabinets", "Managed switches and hardware", "Business Wi‑Fi", "NAS and shared storage", "VPN / secure remote access where appropriate", "Testing", "Documentation and handover"]}
    boundaries={["Small and growing businesses, not enterprise consultancy", "No penetration testing", "No digital forensics", "No blanket cybersecurity or compliance claims", "Windows Server / Active Directory and substantial Linux server work remain separate scopes", "No fixed response-time or availability guarantees"]}
    faqHeading="Useful answers about business network projects"
    faqs={faqs}
    contactContext="business"
  />
</MainLayout>
