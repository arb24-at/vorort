---
import MainLayout from "../layouts/MainLayout.astro";
import HeroHome from "../components/HeroHome.astro";
import TrustBar from "../components/TrustBar.astro";
import ServiceCards from "../components/ServiceCards.astro";
import FaqSection from "../components/FaqSection.astro";
import ContactSection from "../components/ContactSection.astro";
import LanguageSupportBanner from "../components/LanguageSupportBanner.astro";
import { siteConfig } from "../data/site";
---

<MainLayout
  title={`IT-Service vor Ort in Berlin | ${siteConfig.defaultTitleSuffix}`}
  description="Verständlicher IT-Service vor Ort in ganz Berlin für Privatpersonen, Homeoffice und kleine Unternehmen. IT-Erfahrung seit 2008; technischer Service auch auf Englisch."
  canonicalPath=""
  alternatePath="en/"
>
  <HeroHome />
  <LanguageSupportBanner />
  <TrustBar />
  <ServiceCards />

  <section class="section section-soft">
    <div class="container two-grid">
      <section>
        <span class="eyebrow">Arbeitsweise</span>
        <h2 class="section-title">Klare Schritte statt unklarer Technikprozesse</h2>
        <p class="section-lead">
          Vom Erstkontakt bis zur Übergabe arbeiten wir in einem nachvollziehbaren Ablauf. So
          wissen Sie, was als Nächstes passiert.
        </p>
      </section>

      <section class="three-grid">
        <article class="card">
          <h3>1. Anliegen aufnehmen</h3>
          <p>Wir klären Symptom, Dringlichkeit, betroffene Systeme und den passenden Einsatztyp.</p>
        </article>
        <article class="card">
          <h3>2. Strukturierte Behebung</h3>
          <p>Vor Ort oder remote setzen wir priorisierte Maßnahmen für eine stabile Lösung um.</p>
        </article>
        <article class="card">
          <h3>3. Sicher abschliessen</h3>
          <p>Sie erhalten eine klare Zusammenfassung inklusive Empfehlungen für den laufenden Betrieb.</p>
        </article>
      </section>
    </div>
  </section>

  <section class="section">
    <div class="container two-grid">
      <section>
        <span class="eyebrow">Servicegebiet</span>
        <h2 class="section-title">Vor-Ort-Service in ganz Berlin</h2>
        <p class="section-lead">
          Wir nehmen Anfragen aus allen Berliner Bezirken an und helfen dort, wo Ihre Technik
          tatsächlich genutzt wird – zu Hause, im Homeoffice oder am Arbeitsplatz.
        </p>
      </section>
      <aside class="feature-rail">
        <h3 style="margin-top: 0;">Einfach zur passenden Unterstützung</h3>
        <ul>
          <li>Nennen Sie bei der Anfrage einfach Postleitzahl oder Bezirk.</li>
          <li>Vor-Ort-Unterstützung ist der Schwerpunkt des Service.</li>
          <li>Remote-Hilfe kommt ergänzend infrage, wenn sie für das Problem sinnvoll ist.</li>
        </ul>
        <div class="district-list">
          {siteConfig.serviceDistricts.map((district) => <span class="district-pill">{district}</span>)}
        </div>
      </aside>
    </div>
  </section>

  <FaqSection />
  <ContactSection />
</MainLayout>
