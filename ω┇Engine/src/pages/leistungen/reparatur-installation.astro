---
import MainLayout from "../../layouts/MainLayout.astro";
import { siteConfig } from "../../data/site";
import { withBase } from "../../utils/withBase";

const destination = "leistungen/privatpersonen/software-installation-optimierung/";
---

<MainLayout
  title={`Software-Installation & Optimierung Berlin | ${siteConfig.defaultTitleSuffix}`}
  description="Die frühere System-und-Software-Übersicht wurde durch die ausführliche Leistung für Software-Installation und Computer-Optimierung ersetzt."
  canonicalPath={destination}
  robots="noindex, follow"
  redirectPath={destination}
>
  <section class="page-intro">
    <div class="container">
      <span class="eyebrow">Seite aktualisiert</span>
      <h1 class="section-title">Weiter zur Software-Installation und Optimierung</h1>
      <p class="section-lead">
        Diese Übersicht wurde durch eine ausführliche, klar abgegrenzte Leistungsseite ersetzt.
      </p>
      <p><a class="text-link" href={withBase(destination)}>Neue Leistungsseite öffnen →</a></p>
    </div>
  </section>
</MainLayout>
